@page "/MainPage"
@layout MainLayout
@inject NavigationManager Nav
@using SultanCups.Services
@using SultanCups.Models
@inject AdminService AdminService

<style>

    .mainpage-wrap {
        min-height: calc(100vh - 120px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 22px;
        background: #f1f5f9;
    }

    .mainpage-card {
        width: 100%;
        max-width: 1120px;
        border-radius: 34px;
        background: linear-gradient(180deg,#ffffff,#f8fafc);
        border: 1px solid #e2e8f0;
        overflow: hidden;
        box-shadow: 0 25px 60px rgba(15,23,42,.08);
        position: relative;
    }

        .mainpage-card::before {
            content: "";
            position: absolute;
            top: 0;
            right: 0;
            width: 100%;
            height: 5px;
            background: linear-gradient(90deg,#2563eb,#06b6d4);
            z-index: 2;
        }

    .main-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        gap: 30px;
        padding: 34px;
    }

    .left-side {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .quick-actions {
        display: flex;
        gap: 12px;
        margin-bottom: 22px;
        flex-wrap: wrap;
    }

    .quick-btn {
        border: none;
        padding: 12px 20px;
        border-radius: 15px;
        font-size: 14px;
        font-weight: 900;
        cursor: pointer;
        transition: .18s ease;
        color: white;
        box-shadow: 0 10px 25px rgba(37,99,235,.14);
    }

        .quick-btn:hover {
            transform: translateY(-2px);
        }

    .sales-btn {
        background: linear-gradient(135deg,#2563eb,#3b82f6);
    }

    .expense-btn {
        background: linear-gradient(135deg,#0f766e,#14b8a6);
    }

    .verse-box {
        padding: 24px 22px;
        border-radius: 24px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
    }

        .verse-box p {
            margin: 0;
            font-size: 28px;
            font-weight: 900;
            line-height: 1.9;
            color: #0f172a;
        }

    .verse-line {
        width: 80px;
        height: 4px;
        margin-top: 15px;
        border-radius: 50px;
        background: linear-gradient(90deg,#2563eb,#06b6d4);
    }

    .verse-box span {
        display: block;
        margin-top: 14px;
        color: #64748b;
        font-size: 14px;
        font-weight: 800;
    }

    .hadith-box {
        margin-top: 18px;
        padding: 18px;
        border-radius: 22px;
        background: linear-gradient(135deg,#eff6ff,#eef2ff);
        border: 1px solid #dbeafe;
    }

        .hadith-box p {
            margin: 0;
            font-size: 18px;
            font-weight: 900;
            color: #1e3a8a;
            line-height: 2;
        }

    .right-side {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .hero-image {
        width: 100%;
        max-width: 440px;
        height: 320px;
        object-fit: contain;
        border-radius: 28px;
        box-shadow: 0 20px 50px rgba(37,99,235,.14);
    }

    .notes-box {
        width: 100%;
        max-width: 440px;
        min-height: 320px;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 28px;
        padding: 20px;
    }

    .notes-head h3 {
        margin: 0 0 14px 0;
        font-size: 22px;
        font-weight: 900;
    }

    .notes-input {
        width: 100%;
        min-height: 90px;
        border: 1px solid #cbd5e1;
        border-radius: 16px;
        padding: 14px;
        resize: none;
        outline: none;
        font-family: inherit;
        transition: .25s ease;
    }

        .notes-input:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 4px rgba(37,99,235,.10);
        }

    .notes-save {
        margin-top: 12px;
        border: none;
        background: #2563eb;
        color: white;
        padding: 10px 18px;
        border-radius: 14px;
        font-weight: 800;
        cursor: pointer;
    }

    .notes-list {
        margin-top: 18px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        max-height: 180px;
        overflow-y: auto;
        padding-left: 4px;
    }

    .note-item {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 14px;
    }

    .note-date {
        font-size: 12px;
        color: #64748b;
        margin-bottom: 6px;
    }

    .note-text {
        font-size: 15px;
        font-weight: 700;
        color: #0f172a;
        line-height: 1.8;
    }

    .note-delete {
        margin-top: 10px;
        border: none;
        background: #ef4444;
        color: white;
        padding: 6px 12px;
        border-radius: 10px;
        cursor: pointer;
    }

    .notes-mini-logo {
        display: flex;
        justify-content: center;
        margin-bottom: 14px;
    }

        .notes-mini-logo img {
            width: 100%;
            max-width: 100%;
            height: 90px;
            object-fit: cover;
            border-radius: 18px;
            opacity: .96;
            transition: .25s ease;
        }

            .notes-mini-logo img:hover {
                transform: scale(1.04);
            }


    @@media (max-width:950px) {

        .main-content {
            grid-template-columns: 1fr;
            padding: 24px 18px;
        }

        .quick-actions {
            justify-content: center;
        }

        .verse-box,
        .hadith-box,
        .main-footer {
            text-align: center;
        }

        .verse-line {
            margin: 15px auto 0;
        }

        .verse-box p {
            font-size: 24px;
        }

        .hadith-box p {
            font-size: 16px;
        }

        .hero-image {
            max-width: 100%;
            height: auto;
        }
    }

</style>

<div class="mainpage-wrap">

    <div class="mainpage-card">

        <div class="main-content">

            <div class="left-side">

               

                <div class="verse-box">

                    <p>
                        ﴿ وَقُلِ اعْمَلُوا فَسَيَرَى اللَّهُ عَمَلَكُمْ ﴾
                    </p>

                    <div class="verse-line"></div>

                    <span>
                        سورة التوبة - الآية 105
                    </span>

                </div>

                <div class="hadith-box">

                    <p>
                        " من كان منكم حالفًا فليحلف بالله أو ليصمت "
                    </p>

                </div>  <br />

                <div class="quick-actions">

                    <button class="quick-btn sales-btn"
                            @onclick='() => Nav.NavigateTo("/orders")'>
                        الانتقال للفواتير
                    </button>

                    <button class="quick-btn expense-btn"
                            @onclick='() => Nav.NavigateTo("/OtherPurchases")'>
                        المصروفات الأخرى
                    </button>

                </div>

            </div>



            <div class="right-side">

                <div class="notes-box">

                    <div class="notes-mini-logo">
                        <img src="images/background.png" />
                    </div>

                    <div class="notes-head">
                        <h3>الملاحظات العامة</h3>
                    </div>

                    <textarea class="notes-input"
                              placeholder="اكتب ملاحظة..."
                              maxlength="300"
                              @bind="NewNote"></textarea>

                    <button class="notes-save"
                            @onclick="AddNote">
                        حفظ الملاحظة
                    </button>

                    <div class="notes-list">

                        @foreach (var note in Notes)
                        {
                            <div class="note-item">

                                <div class="note-date">
                                    @note.created_at.ToLocalTime().ToString("yyyy/MM/dd")
                                </div>

                                <div class="note-text">
                                    @note.note_text
                                </div>

                                <button class="note-delete"
                                        @onclick="() => DeleteNote(note.note_id)">
                                    حذف
                                </button>

                            </div>
                        }

                    </div>
                </div>

            </div>

        </div>

    </div>

</div>


@code {

    List<QuickNote> Notes = new();

    string NewNote = "";

    protected override async Task OnInitializedAsync()
    {
        Notes = await AdminService.GetQuickNotes();
    }

    async Task AddNote()
    {
        if (string.IsNullOrWhiteSpace(NewNote))
            return;

        await AdminService.AddQuickNote(NewNote);

        NewNote = "";

        Notes = await AdminService.GetQuickNotes();
    }

    async Task DeleteNote(int id)
    {
        await AdminService.DeleteQuickNote(id);

        Notes = await AdminService.GetQuickNotes();
    }

}