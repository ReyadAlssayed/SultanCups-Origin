@page "/MainPage"

<style>

    .mainpage-wrap {
        min-height: calc(100vh - 120px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px;
        background: #f1f5f9;
    }

    .mainpage-card {
        width: 100%;
        max-width: 1200px;
        border-radius: 34px;
        background: linear-gradient(180deg,#ffffff,#f8fafc);
        border: 1px solid #e2e8f0;
        overflow: hidden;
        box-shadow: 0 25px 60px rgba(15,23,42,.08);
        position: relative;
    }

        .mainpage-card::before {
            content: "";
            position: absolute;
            top: 0;
            right: 0;
            width: 100%;
            height: 5px;
            background: linear-gradient(90deg,#2563eb,#06b6d4);
            z-index: 2;
        }

    .main-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 40px;
        padding: 45px;
    }

    .left-side {
        flex: 1;
    }

    .system-title {
        margin: 0;
        font-size: 58px;
        font-weight: 900;
        color: #0f172a;
        line-height: 1.1;
    }

    .system-subtitle {
        margin-top: 14px;
        font-size: 22px;
        font-weight: 800;
        color: #06b6d4;
    }

    .verse-box {
        margin-top: 38px;
        padding: 30px 24px;
        border-radius: 26px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
    }

    .verse-line {
        width: 80px;
        height: 4px;
        margin-bottom: 20px;
        border-radius: 50px;
        background: linear-gradient(90deg,#2563eb,#06b6d4);
    }

    .verse-box p {
        margin: 0;
        font-size: 30px;
        font-weight: 900;
        line-height: 2;
        color: #0f172a;
    }

    .verse-box span {
        display: block;
        margin-top: 16px;
        color: #64748b;
        font-size: 14px;
        font-weight: 800;
    }

    .hadith-box {
        margin-top: 22px;
        padding: 22px;
        border-radius: 22px;
        background: linear-gradient(135deg,#eff6ff,#eef2ff);
        border: 1px solid #dbeafe;
    }

        .hadith-box p {
            margin: 0;
            font-size: 18px;
            font-weight: 800;
            color: #1e3a8a;
            line-height: 2;
        }

    .main-footer {
        margin-top: 35px;
        font-size: 15px;
        font-weight: 900;
        color: #6366f1;
        letter-spacing: .5px;
    }

    .right-side {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .hero-image {
        width: 100%;
        max-width: 520px;
        border-radius: 28px;
        object-fit: cover;
        box-shadow: 0 25px 60px rgba(37,99,235,.20);
        border: 1px solid rgba(255,255,255,.4);
    }

    @@media (max-width:950px) {

        .main-content {
            flex-direction: column-reverse;
            padding: 30px 22px;
        }

        .system-title {
            font-size: 42px;
            text-align: center;
        }

        .system-subtitle {
            text-align: center;
        }

        .verse-line {
            margin: auto auto 20px;
        }

        .verse-box,
        .hadith-box,
        .main-footer {
            text-align: center;
        }

            .verse-box p {
                font-size: 24px;
            }

        .hero-image {
            max-width: 100%;
        }
    }

</style>

<div class="mainpage-wrap">

    <div class="mainpage-card">

        <div class="main-content">

            <div class="left-side">

                <div class="verse-box">

                    <div class="verse-line"></div>

                    <p>
                        ﴿ وَقُلِ اعْمَلُوا فَسَيَرَى اللَّهُ عَمَلَكُمْ ﴾
                    </p>

                    <span>
                        سورة التوبة - الآية 105
                    </span>

                </div>

                <div class="hadith-box">

                    <p>
                        " إن الله يحب إذا عمل أحدكم عملاً أن يتقنه "
                    </p>

                </div>

                <div class="main-footer">

                    الحداثة للأنظمة الرقمية

                </div>

            </div>

            <div class="right-side">

                <img src="images/MainPic.png"
                     class="hero-image" />

            </div>

        </div>

    </div>

</div>