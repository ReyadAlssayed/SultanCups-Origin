@page "/MainPage"
@layout MainLayout
@inject NavigationManager Nav

<style>

    .mainpage-wrap {
        min-height: calc(100vh - 120px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 22px;
        background: #f1f5f9;
    }

    .mainpage-card {
        width: 100%;
        max-width: 1120px;
        border-radius: 34px;
        background: linear-gradient(180deg,#ffffff,#f8fafc);
        border: 1px solid #e2e8f0;
        overflow: hidden;
        box-shadow: 0 25px 60px rgba(15,23,42,.08);
        position: relative;
    }

        .mainpage-card::before {
            content: "";
            position: absolute;
            top: 0;
            right: 0;
            width: 100%;
            height: 5px;
            background: linear-gradient(90deg,#2563eb,#06b6d4);
            z-index: 2;
        }

    .main-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        gap: 30px;
        padding: 34px;
    }

    .left-side {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .quick-actions {
        display: flex;
        gap: 12px;
        margin-bottom: 22px;
        flex-wrap: wrap;
    }

    .quick-btn {
        border: none;
        padding: 12px 20px;
        border-radius: 15px;
        font-size: 14px;
        font-weight: 900;
        cursor: pointer;
        transition: .18s ease;
        color: white;
        box-shadow: 0 10px 25px rgba(37,99,235,.14);
    }

        .quick-btn:hover {
            transform: translateY(-2px);
        }

    .sales-btn {
        background: linear-gradient(135deg,#2563eb,#3b82f6);
    }

    .expense-btn {
        background: linear-gradient(135deg,#0f766e,#14b8a6);
    }

    .verse-box {
        padding: 24px 22px;
        border-radius: 24px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
    }

        .verse-box p {
            margin: 0;
            font-size: 28px;
            font-weight: 900;
            line-height: 1.9;
            color: #0f172a;
        }

    .verse-line {
        width: 80px;
        height: 4px;
        margin-top: 15px;
        border-radius: 50px;
        background: linear-gradient(90deg,#2563eb,#06b6d4);
    }

    .verse-box span {
        display: block;
        margin-top: 14px;
        color: #64748b;
        font-size: 14px;
        font-weight: 800;
    }

    .hadith-box {
        margin-top: 18px;
        padding: 18px;
        border-radius: 22px;
        background: linear-gradient(135deg,#eff6ff,#eef2ff);
        border: 1px solid #dbeafe;
    }

        .hadith-box p {
            margin: 0;
            font-size: 18px;
            font-weight: 900;
            color: #1e3a8a;
            line-height: 2;
        }

    .right-side {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .hero-image {
        width: 100%;
        max-width: 440px;
        height: 320px;
        object-fit: contain;
        border-radius: 28px;
        box-shadow: 0 20px 50px rgba(37,99,235,.14);
    }

    @@media (max-width:950px) {

        .main-content {
            grid-template-columns: 1fr;
            padding: 24px 18px;
        }

        .quick-actions {
            justify-content: center;
        }

        .verse-box,
        .hadith-box,
        .main-footer {
            text-align: center;
        }

        .verse-line {
            margin: 15px auto 0;
        }

        .verse-box p {
            font-size: 24px;
        }

        .hadith-box p {
            font-size: 16px;
        }

        .hero-image {
            max-width: 100%;
            height: auto;
        }
    }

</style>

<div class="mainpage-wrap">

    <div class="mainpage-card">

        <div class="main-content">

            <div class="left-side">

                <div class="quick-actions">

                    <button class="quick-btn sales-btn"
                            @onclick='() => Nav.NavigateTo("/orders")'>
                        الانتقال للفواتير
                    </button>

                    <button class="quick-btn expense-btn"
                            @onclick='() => Nav.NavigateTo("/OtherPurchases")'>
                        المصروفات الأخرى
                    </button>

                </div>

                <div class="verse-box">

                    <p>
                        ﴿ وَقُلِ اعْمَلُوا فَسَيَرَى اللَّهُ عَمَلَكُمْ ﴾
                    </p>

                    <div class="verse-line"></div>

                    <span>
                        سورة التوبة - الآية 105
                    </span>

                </div>

                <div class="hadith-box">

                    <p>
                        " من كان منكم حالفًا فليحلف بالله أو ليصمت "
                    </p>

                </div>

            </div>

            <div class="right-side">

                <img src="images/MainPic.png"
                     class="hero-image" />

            </div>

        </div>

    </div>

</div>