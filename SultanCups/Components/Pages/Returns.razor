@page "/returns"
@layout Layout.MainLayout

@using SultanCups.Models
@using SultanCups.Services

@inject FinanceService2 FinanceService
@inject NavigationManager Nav

<div class="pro-page">

    <div class="pro-topbar">
        <div></div>

        <h2 class="pro-title">
            سجل البضاعة الراجعة
        </h2>

        <div></div>
    </div>

    <div class="pro-search-bar">

        <input class="mk-search-input"
               placeholder="بحث برقم الفاتورة أو المنتج"
               @bind="SearchText"
               @bind:event="oninput" />

        <input type="date"
               class="pro-filter-select"
               @bind="DateFilter" />

    </div>

    <div class="pro-card">

        <div class="pro-table-wrap">

            <table class="pro-table">

                <thead>
                    <tr>
                        <th>رقم الفاتورة</th>
                        <th>المنتج</th>
                        <th>الكمية الراجعة</th>
                        <th>التاريخ</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>

                <tbody>

                    @if (ReturnList == null)
                    {
                        <tr>
                            <td colspan="5">
                                جاري التحميل...
                            </td>
                        </tr>
                    }

                    else if (!FilteredList.Any())
                    {
                        <tr>
                            <td colspan="5" class="st-empty-text">

                                <div class="empty-state">

                                    <img src="images/Empty.jpg"
                                         class="empty-img" />

                                    <span>
                                        لا توجد بيانات راجع
                                    </span>

                                </div>

                            </td>
                        </tr>
                    }

                    else
                    {
                        @foreach (var r in FilteredList)
                        {
                            <tr>

                                <td class="pro-code">
                                    @r.order_id
                                </td>

                                <td>
                                    @r.product_name
                                </td>

                                <td>
                                    <span class="pro-total">
                                        @r.returned_quantity صندوق
                                    </span>
                                </td>

                                <td class="pro-muted">
                                    @r.return_date.ToString("yyyy-MM-dd")
                                </td>

                                <td>

                                    <button class="debt-go-order-btn"
                                            @onclick='() => Nav.NavigateTo($"/orders?new={r.order_id}")'>

                                        الانتقال إلى الفاتورة

                                    </button>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@code {

    List<ReturnView>? ReturnList;

    string SearchText = "";

    DateTime? DateFilter;

    protected override async Task OnInitializedAsync()
    {
        ReturnList = await FinanceService.GetReturns();
    }

    IEnumerable<ReturnView> FilteredList =>

        (ReturnList ?? Enumerable.Empty<ReturnView>())

        .Where(r =>

            (

                string.IsNullOrWhiteSpace(SearchText)

                ||

                r.order_id
                .ToString()
                .Contains(SearchText)

                ||

                r.product_name
                .Contains(
                    SearchText,
                    StringComparison.OrdinalIgnoreCase
                )
            )

            &&

            (

                DateFilter == null

                ||

                r.return_date.Date
                ==
                DateFilter.Value.Date
            )
        );
}