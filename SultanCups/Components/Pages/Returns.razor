@page "/returns"
@layout Layout.MainLayout

@using SultanCups.Models
@using SultanCups.Services

@inject FinanceService2 FinanceService
@inject NavigationManager Nav
@using ClosedXML.Excel
@inject IJSRuntime JS


<div class="pro-page">

    <div class="pro-topbar">

        <h2 class="pro-title">
            سجل البضاعة الراجعة
        </h2>

        <button class="pro-btn-excel"
                @onclick="ExportToExcel"
                disabled="@IsExporting">
            أرشفة Excel
        </button>

       

        <div></div>

    </div>

    <div class="pro-search-bar">

        <input class="mk-search-input"
               placeholder="بحث برقم الفاتورة أو المنتج"
               @bind="SearchText"
               @bind:event="oninput" />

        <input type="date"
               class="pro-filter-select"
               @bind="DateFilter" />

    </div>

    <div class="pro-card">

        <div class="pro-table-wrap">

            <table class="pro-table">

                <thead>
                    <tr>
                        <th>رقم الفاتورة</th>
                        <th>المنتج</th>
                        <th>الكمية الراجعة</th>
                        <th>التاريخ</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>

                <tbody>

                    @if (ReturnList == null)
                    {
                        <tr>
                            <td colspan="5">
                                جاري التحميل...
                            </td>
                        </tr>
                    }

                    else if (!FilteredList.Any())
                    {
                        <tr>
                            <td colspan="5" class="st-empty-text">

                                <div class="empty-state">

                                    <img src="images/Empty.jpg"
                                         class="empty-img" />

                                    <span>
                                        لا توجد بيانات راجع
                                    </span>

                                </div>

                            </td>
                        </tr>
                    }

                    else
                    {
                        @foreach (var r in FilteredList)
                        {
                           
                            <tr>

                                <td class="pro-code">
                                    @r.order_id
                                </td>

                                <td>
                                    @r.product_name
                                </td>

                                <td>
                                    <span class="pro-total">
                                        @r.returned_quantity صندوق
                                    </span>
                                </td>

                                <td class="pro-muted">
                                    @r.return_date.ToString("yyyy-MM-dd")
                                </td>

                                <td>

                                    <button class="debt-go-order-btn"
                                            @onclick='() => Nav.NavigateTo($"/orders?new={r.order_id}")'>

                                        الانتقال إلى الفاتورة

                                    </button>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@if (IsExporting)
{
    <div class="excel-loading-overlay">
        <div class="excel-loading-box">
            جاري الأرشفة...
        </div>
    </div>
}

@code {

    List<ReturnView>? ReturnList;

    string SearchText = "";

    DateTime? DateFilter;


    bool IsExporting = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ReturnList = await FinanceService.GetReturns();
           
        }
        catch
        {
            ReturnList = new();
        }
    }

    async Task ExportToExcel()
    {
        if (IsExporting)
            return;

        IsExporting = true;

        await InvokeAsync(StateHasChanged);
        await Task.Delay(300);

        try
        {
            using var workbook = new XLWorkbook();

            var ws =
                workbook.Worksheets.Add("الراجع");

            ws.Cell(1, 1).Value = "رقم الفاتورة";
            ws.Cell(1, 2).Value = "المنتج";
            ws.Cell(1, 3).Value = "الكمية";
            ws.Cell(1, 4).Value = "التاريخ";

            int row = 2;

            foreach (var r in FilteredList)
            {
                ws.Cell(row, 1).Value = r.order_id;
                ws.Cell(row, 2).Value = r.product_name;
                ws.Cell(row, 3).Value =
                    r.returned_quantity;

                ws.Cell(row, 4).Value =
                    r.return_date.ToString("yyyy-MM-dd");

              
                row++;
            }

            ws.Row(1).Style.Font.Bold = true;

            ws.Row(1).Style.Fill.BackgroundColor =
                XLColor.LightGreen;

            ws.Columns().AdjustToContents();

            ws.RightToLeft = true;

            using var stream = new MemoryStream();

            workbook.SaveAs(stream);

            await JS.InvokeVoidAsync(
                "downloadFile",
                $"Returns_{DateTime.Now:yyyyMMddHHmmss}.xlsx",
                Convert.ToBase64String(stream.ToArray())
            );
        }
        finally
        {
            IsExporting = false;

            await InvokeAsync(StateHasChanged);
        }
    }

    IEnumerable<ReturnView> FilteredList =>

        (ReturnList ?? Enumerable.Empty<ReturnView>())

        .Where(r =>

            (

                string.IsNullOrWhiteSpace(SearchText)

                ||

                r.order_id
                .ToString()
                .Contains(SearchText)

                ||

                r.product_name
                .Contains(
                    SearchText,
                    StringComparison.OrdinalIgnoreCase
                )
            )

            &&

            (

                DateFilter == null

                ||

                r.return_date.Date
                ==
                DateFilter.Value.Date
            )
        );
}