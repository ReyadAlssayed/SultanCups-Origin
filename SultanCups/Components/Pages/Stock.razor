@page "/stock"
@using SultanCups.Models
@using SultanCups.Services
@layout Layout.MainLayout
@inject UserSession Session

@inject InventoryService InventoryService
@inject ToastService ToastService

<div class="pro-page">

    <div class="pro-topbar">

        @if (
            Session.Role == "Admin1"
            &&
            Session.FullName == "مطور النظام"
            &&
            Session.Phone == "0910772372"
        )
        {
            <button class="pro-btn-add"
                    @onclick="OpenResetStockDialog">
                تصفير المخزن
            </button>
        }

        <h2 class="pro-title">
            المخزن الحركي
        </h2>

    </div>

    <div class="pro-card">
        <div class="pro-table-wrap">

            <table class="pro-table">
                <thead>
                    <tr>
                        <th>المنتج</th>
                        <th>الكمية</th>
                    </tr>
                </thead>

                <tbody>
                    @if (stockList == null)
                    {
                        <tr>
                            <td colspan="2">تحميل...</td>
                        </tr>
                    }
                    else if (!stockList.Any())
                    {
                        <tr>
                            <td colspan="2" class="st-empty-text">
                                <div class="empty-state">
                                    <img src="images/Empty.jpg" class="empty-img" />
                                    <span>لا يوجد إنتاج — المخزن فارغ</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var s in stockList)
                        {
                            <tr>
                                <td class="pro-name">
                                    @s.Product?.name
                                </td>
                                <td class="pro-money">
                                    @s.quantity
                                </td>
                            </tr>
                        }
                    }
                </tbody>

            </table>
          
            @if (stockList != null && stockList.Any())
            {
                <div class="stock-video-box">
                    <img src="images/Cart.jpg" class="stock-end-img" />

                    <span class="inv-muted">— نهاية المخزن —</span>
                </div>
            }


        </div>
    </div>

</div>

@if (ShowResetStockDialog)
{
    <div class="pro-dialog-overlay">

        <div class="pro-dialog-box">

            <div class="pro-dialog-top-image">
                <img src="images/Background.png" />
            </div>

            <div class="pro-dialog-body">

                <div class="pro-delete-icon">
                    !
                </div>

                <h3 class="pro-delete-title">
                    تصفير المخزن
                </h3>

                <p class="pro-delete-text text-center-delete">

                    هل قمت بأرشفة المخزن إلى Excel؟

                    <br />
                    <br />

                    سيتم تصفير جميع كميات المخزن الحالية.

                </p>

                <div class="pro-dialog-actions">

                    <button class="pro-delete-confirm"
                            @onclick="ResetStock">
                        تصفير الآن
                    </button>

                    <button class="pro-cancel"
                            @onclick="CloseDialogs">

                        إلغاء

                    </button>

                </div>

            </div>

        </div>

    </div>
}

@code {
    List<ProductStock>? stockList;

    bool ShowResetStockDialog;

    void OpenResetStockDialog()
    {
        ShowResetStockDialog = true;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            stockList = await InventoryService.GetStock();
        }
        catch
        {
            stockList = new();
        }
    }

    async Task ResetStock()
    {
        try
        {
            await InventoryService.ResetStock();

            stockList = await InventoryService.GetStock();

            CloseDialogs();

            ToastService.ShowToast(
                "تم تصفير المخزن بنجاح",
                "success"
            );
        }
        catch (Exception ex)
        {
            ToastService.ShowToast(
                ex.InnerException?.Message ?? ex.Message,
                "error"
            );
        }
    }

    void CloseDialogs()
    {
        ShowResetStockDialog = false;
    }
}