@page "/orders/add"

@layout Layout.MainLayout
@using SultanCups.Models
@using SultanCups.Services
@inject UserSession Session
@inject FinanceService2 FinanceService
@inject InventoryService InventoryService
@inject SalesService SalesService
@inject ToastService ToastService
@inject NavigationManager Nav



<div class="pro-page">

  
    <div class="top-bar">

        <button class="btn-back" @onclick='() => Nav.NavigateTo("/orders")'>
            ← رجوع
        </button>

        <h3>إضافة فاتورة رقم @NextOrderNumber</h3>

    </div>

    <div class="pro-fields-grid pro-animate">

        <div>
            <label>نوع الشخص</label>
            <select class="pro-input" @bind="Form.person_type">
                <option value="customer">زبون</option>
                <option value="marketer">مسوق</option>
            </select>
        </div>

        @if (Form.person_type == "customer")
        {
            <div>
                <label>الزبون</label>

                <select class="pro-input @(PersonError == "" ? "" : "is-invalid")"
                        @bind="Form.person_id">
                    <option value="0">اختر زبون</option>
                    @foreach (var c in Customers)
                    {
                        <option value="@c.customer_id">@c.name</option>
                    }
                </select>

                @if (PersonError != "")
                {
                    <div class="pro-error-text">@PersonError</div>
                }
            </div>
        }

        @if (Form.person_type == "marketer")
        {
            <div>
                <label>المسوق</label>

                <select class="pro-input @(PersonError == "" ? "" : "is-invalid")"
                        value="@Form.person_id"
                        @onchange="OnMarketerChanged">
                    <option value="0">اختر مسوق</option>
                    @foreach (var m in Marketers)
                    {
                        <option value="@m.marketer_id">@m.name</option>
                    }
                </select>

                @if (PersonError != "")
                {
                    <div class="pro-error-text">@PersonError</div>
                }
            </div>

            <div>
                <label>عمولة الصندوق</label>
                <input class="pro-input" @bind="Form.commission_per_box" />
            </div>
        }

        <div>
            <label>التاريخ</label>
            <input type="date"
                   class="pro-input"
                   @bind="Form.order_date" />
        </div>

       
        <div class="pay-btn-wrap">
            <button class="btn-info fixed-btn" @onclick="OpenPaymentDialog">
                💳 دفع
            </button>
        </div>

        <div>
        </div>

    </div>

    <hr />

    <div class="order-layout1">

        <!-- 🔹 اليمين (جدول الأصناف) -->
        <div class="order-right1">

            <h4>الأصناف</h4>

            <table class="order-table1">
                <thead>
                    <tr class="item-row1 open">
                        <th>المنتج</th>
                        <th>السعر</th>
                        <th>الكمية</th>
                        <th>الإجمالي</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Form.Items)
                    {
                        <tr @key="item" class="item-row1 @(item.IsRemoving ? "" : "open")">

                            <td>
                                <select class="pro-input"
                                        value="@item.product_id"
                                        @onchange="e => OnProductChanged(e, item)">
                                    <option value="0">اختر منتج</option>
                                    @foreach (var p in Products)
                                    {
                                        <option value="@p.product_id">@p.name</option>
                                    }
                                </select>
                            </td>

                            <td>
                                <input type="number"
                                       step="0.01"
                                       class="pro-input"
                                       @bind-value="item.unit_price"
                                       @bind-value:event="oninput" />
                            </td>
                            <td>
                                <input type="number"
                                       class="pro-input"
                                       @bind-value="item.quantity"
                                       @bind-value:event="oninput" />
                            </td>


                            <td>
                                <input class="pro-input"
                                       value="@(item.quantity * item.unit_price)"
                                       readonly />
                            </td>

                            <td>
                                @if (Form.Items.Count > 1)
                                {
                                    <button class="btn-delete-item1"
                                            @onclick="() => RemoveItem(item)">
                                        ✕
                                    </button>
                                }
                            </td>

                        </tr>
                    }
                </tbody>
            </table>

            @if (ProductError != "")
            {
                <div class="pro-error-text">@ProductError</div>
            }

            <button class="pro-btn-add small" @onclick="AddItem">
                إضافة صنف
            </button>

            <div class="bottom-actions1">

                <button class="pro-save"
                        @onclick="SaveOrder"
                        disabled="@IsSaving">

                    @if (IsSaving)
                    {
                        <span class="save-loader"></span>
                        <span>جاري الحفظ...</span>
                    }
                    else
                    {
                        <span>حفظ الفاتوره</span>
                    }

                </button>

                <button class="pro-cancel"
                        @onclick='() => Nav.NavigateTo("/orders")'>
                    إلغاء
                </button>

            </div>

        </div>


        <!-- 🔹 اليسار (الإجمالي) -->
        <div class="order-left1">

            <div class="summary-box1">

                <label>الخصم <span class="muted1">(اختياري)</span></label>
                <input type="number"
                       class="pro-input"
                       @bind-value="Form.discount_total"
                       @bind-value:event="oninput" />

                <hr />
                @if (Form.person_type == "marketer")
                {
                    <div class="sum-line1">
                        <span>العمولة</span>
                        <strong class="@(IsCommissionAllowed ? "text-success" : "text-danger")">
                            @Fmt(Commission)
                        </strong>
                    </div>

                    <div class="sum-line1 small">
                        <span>حالة العمولة</span>
                        <strong class="commission-status @(IsCommissionAllowed ? "ok" : "no")">
                            @(IsCommissionAllowed ? "✔ تُصرف" : "❌ معلقة حتى السداد")
                        </strong>
                    </div>
                }

                @{
                    var remaining = Net - PaymentsTotal;
                    bool isPaid = Net > 0 && remaining <= 0;
                    bool isPartial = PaymentsTotal > 0 && remaining > 0;
                }

                @if (Form.discount_total > 0)
                {
                    <div class="sum-line1 small">
                        <span>الإجمالي قبل الخصم</span>
                        <strong>@Fmt(Total)</strong>
                    </div>

                    <div class="sum-line1 main">
                        <span>الإجمالي بعد الخصم</span>
                        <strong>@Fmt(Net)</strong>
                    </div>
                }
                else
                {
                    <div class="sum-line1 main">
                        <span>الإجمالي</span>
                        <strong>@Fmt(Net)</strong>
                    </div>
                }

                <div class="sum-line1 small">
                    <span>المدفوع</span>
                    <strong class="text-success">@Fmt(PaymentsTotal)</strong>
                </div>

                <div class="sum-line1 small">
                    <span>المتبقي</span>
                    <strong class="@(remaining > 0 ? "text-danger" : "text-success")">
                        @Fmt(remaining)
                    </strong>
                </div>

                <div class="sum-line1 status">
                    <span>الحالة</span>
                    @if (Net == 0)
                    {
                        <div class="status-bar neutral">—</div>
                    }
                    else if (isPaid)
                    {
                        <div class="status-bar paid">✔ تم السداد</div>
                    }
                    else if (isPartial)
                    {
                        <div class="status-bar partial">◐ خالص جزئي</div>
                    }
                    else
                    {
                        <div class="status-bar not-paid">⚠ غير خالص</div>
                    }
                </div>

                @if (Form.person_type == "marketer")
                {
                    var marketer = Marketers.FirstOrDefault(m => m.marketer_id == Form.person_id);

                    @if (marketer != null && !marketer.is_special)
                    {
                        <span class="note1">
                            لن تُصرف العمولة إلا بعد سداد الفاتورة بالكامل
                        </span>
                    }
                }


                <div class="notes-wrapper">
                    <label>ملاحظات</label>

                    <textarea class="notes1"
                              placeholder="اكتب أي ملاحظة..."
                              @bind="Form.notes"></textarea>

                    
                </div>

            </div>

           

        </div>

    </div>

</div>


@if (ShowPaymentDialog)
{
    <div class="rm-dialog-overlay">

        <div class="rm-dialog-box pay-dialog">

            <div class="pro-dialog-top-image">
                <img src="images/Background.png" />
            </div>

            <div class="rm-dialog-body">

                <div class="money-head">
                    <h3>طرق الدفع</h3>
                    <img src="images/Money.jpg" />
                </div>

                <div class="cashbox-inline">

                    <label class="cash-label">الخزنة</label>

                    <select class="pay-input1 small" @bind="Form.cash_box_id">
                        <option value="">اختر</option>
                        @foreach (var c in CashBoxes)
                        {
                            <option value="@c.cash_box_id">@c.name</option>
                        }
                    </select>

                </div>

                <div class="payments-box">

                    <div class="payment-header1">
                        <span>النوع</span>
                        <span>المبلغ</span>
                        <span></span>
                    </div>

                    @foreach (var p in TempPayments)
                    {
                        <div class="payment-row1">

                            <select class="pay-input1" value="@p.method"
                                    @onchange="e => OnPaymentMethodChanged(e, p)">

                                @foreach (var m in new[] { "cash", "card", "transfer", "check" })
                                {
                                    var used = TempPayments.Any(x => x.method == m && x != p);

                                    if (!used || m == p.method)
                                    {
                                        <option value="@m">@GetMethodName(m)</option>
                                    }
                                }

                            </select>

                            <input class="pay-input1"
                                   @bind="p.amount"/>                    

                            <button class="pay-delete1"
                                    @onclick="() => TempPayments.Remove(p)">
                                حذف
                            </button>

                        </div>
                    }

                    <button class="rm-add-btn small" @onclick="AddTempPayment">
                         إضافة دفعة
                    </button>

                </div>

                <div class="pay-actions1">
                    <button class="pay-save1" @onclick="ClosePaymentDialog">تم</button>
                    <button class="pay-cancel1" @onclick="CancelPaymentDialog">إلغاء</button>
                </div>

            </div>

        </div>
    </div>
}





@code {

    List<Product> Products = new();

    int CurrentAdminId => Session.AdminId;

    Order Form = new();
    List<Customer> Customers = new();
    List<Marketer> Marketers = new();
    List<CashBox> CashBoxes = new();

    string PersonError = "";
    string ItemsError = "";
    string ProductError = "";
    string QuantityError = "";
    string CashBoxError = "";
    string PaidError = "";

    bool IsSaving = false;
    
    bool ShowPaymentDialog = false;


    List<PaymentInput> TempPayments = new();
    List<PaymentInput> Payments = new();

    int NextOrderNumber = 1;

    protected override async Task OnInitializedAsync()
    {
        Products = await InventoryService.GetProducts();
        Customers = await SalesService.GetActiveCustomers();
        Marketers = await SalesService.GetActiveMarketers();
        CashBoxes = await FinanceService.GetCashBoxes();

            Form = new Order
            {
                order_date = DateTime.UtcNow, // 🔥 الحل
                person_type = "marketer",
                person_id = 0,
                Items = new List<OrderItem>
            {
                new OrderItem
                {
                    product_id = 0,
                    quantity = 1,
                    unit_price = 0
                }
            }
            };

            var orders = await FinanceService.GetOrders();

if (orders.Any())
{
    NextOrderNumber = orders.Max(x => x.order_id) + 1;
}
        }
    

    async Task RemoveItem(OrderItem item)
    {
        item.IsRemoving = true;
        await Task.Delay(200);
        Form.Items.Remove(item);
    }

    void CancelPaymentDialog()
    {
        ShowPaymentDialog = false;
    }

    string GetMethodName(string m) => m switch
    {
        "cash" => "كاش",
        "card" => "بطاقة",
        "transfer" => "تحويل",
        "check" => "شيك",
        _ => m
    };

    void OnPaymentMethodChanged(ChangeEventArgs e, PaymentInput current)
    {
        var newMethod = e.Value?.ToString();

        var exists = TempPayments
            .Any(p => p.method == newMethod && p != current);

        if (exists)
        {
            ToastService.ShowToast("لا يمكن تكرار نفس نوع الدفع", "error");
            return;
        }

        current.method = newMethod!;
    }

    void HandleEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            ClosePaymentDialog();
        }
    }

    void AddTempPayment()
    {
        if (TempPayments.Count >= 4) return;

        var methods = TempPayments.Select(x => x.method).ToList();
        var all = new[] { "cash", "card", "transfer", "check" };

        var next = all.FirstOrDefault(m => !methods.Contains(m));

        if (next == null)
        {
            ToastService.ShowToast("لا يمكن تكرار نفس نوع الدفع", "error");
            return;
        }

        TempPayments.Add(new PaymentInput
        {
            method = next,
            amount = 0
        });
    }

    void OnMarketerChanged(ChangeEventArgs e)
    {
        int id = int.Parse(e.Value?.ToString() ?? "0");

        Form.person_id = id;

        var marketer = Marketers.FirstOrDefault(m => m.marketer_id == id);

        if (marketer != null)
        {
            Form.commission_per_box = marketer.commission_per_box;
        }

        // 🔥 هذا السطر المهم
        StateHasChanged();
    }

    bool IsCommissionAllowed
    {
        get
        {
            if (Form.person_type != "marketer")
                return false;

            var marketer = Marketers.FirstOrDefault(m => m.marketer_id == Form.person_id);

            if (marketer == null)
                return false;

            // 🔥 التعديل هنا
            if (marketer.is_special)
                return true;

            return Net > 0 && PaymentsTotal >= Net;
        }
    }

    void OpenPaymentDialog()
    {
        TempPayments = Payments
            .Select(p => new PaymentInput
            {
                method = p.method,
                amount = p.amount
            }).ToList();

        if (!TempPayments.Any())
        {
            TempPayments.Add(new PaymentInput
            {
                method = "cash",
                amount = 0
            });
        }

        ShowPaymentDialog = true;
    }

    void ClosePaymentDialog()
    {
        if (TempPayments.Any(p => p.amount < 0))
        {
            ToastService.ShowToast("لا يمكن إدخال مبلغ سالب", "error");
            return;
        }

        if (TempPayments.Any(p => string.IsNullOrWhiteSpace(p.method)))
        {
            ToastService.ShowToast("اختر نوع الدفع لكل سجل", "error");
            return;
        }


        if (TempPayments.Sum(p => p.amount) > Net)
        {
            ToastService.ShowToast("مجموع الدفعات أكبر من الإجمالي", "error");
            return;
        }

        if (TempPayments.Sum(p => p.amount) > 0 && Form.cash_box_id <= 0)
        {
            ToastService.ShowToast("اختر الخزنة أولاً", "error");
            return;
        }

        // ✔ فقط هنا يتم الاعتماد
        Payments = TempPayments
            .Select(p => new PaymentInput
            {
                method = p.method,
                amount = p.amount
            }).ToList();

        ShowPaymentDialog = false;
    }

    async Task AddItem()
    {
        var item = new OrderItem
        {
            product_id = 0,
            quantity = 1,
            unit_price = 0,
            IsRemoving = true
        };

        Form.Items.Add(item);

        await Task.Delay(10);

        item.IsRemoving = false;
    }

    decimal Total => Form.Items.Sum(i => i.quantity * i.unit_price);

    decimal Net => Math.Max(0, Total - Form.discount_total);

    decimal Commission
    {
        get
        {
            if (Form.person_type != "marketer")
                return 0;

            var qty = Form.Items.Sum(i => i.quantity);
            return qty * Form.commission_per_box;
        }
    }


    void OnProductChanged(ChangeEventArgs e, OrderItem item)
    {
        int id = int.Parse(e.Value?.ToString() ?? "0");

        var existing = Form.Items
     .FirstOrDefault(i =>
         i.product_id == id &&
         i != item &&
         i.product_id != 0
     );

        if (existing != null)
        {
            Form.Items.Remove(item);

            ToastService.ShowToast("هذا المنتج مضاف مسبقًا، عدّل الكمية بدلًا من إضافة صف جديد", "error");
            return;
        }

        // ✔ بعد التأكد فقط
        item.product_id = id;

        var product = Products.FirstOrDefault(p => p.product_id == id);

        if (product != null)
        {
            item.unit_price = product.sale_price;
        }
    }

    decimal PaymentsTotal => Payments.Sum(p => p.amount);


    async Task SaveOrder()
    {
        try
        {

            if (IsSaving)
                return;

            Form.order_date = DateTime.SpecifyKind(Form.order_date, DateTimeKind.Utc);
            PersonError = "";
            ItemsError = "";
            ProductError = "";
            QuantityError = "";
            CashBoxError = "";


            IsSaving = true;

            bool hasError = false;

            if (Form.person_id == 0)
            {
                PersonError = "اختر الزبون أو المسوق";
                hasError = true;
            }

            if (!Form.Items.Any())
            {
                ItemsError = "أضف صنف واحد على الأقل";
                hasError = true;
            }

            if (Form.Items.Any(i => i.product_id == 0))
            {
                ProductError = "اختر المنتج";
                hasError = true;
            }

            if (Form.Items.Any(i => i.quantity <= 0))
            {
                QuantityError = "الكمية غير صحيحة";
                hasError = true;
            }

            var realPaid = Payments.Sum(p => p.amount);

            if (realPaid > 0)
            {
                if (Form.cash_box_id <= 0)
                {
                    ToastService.ShowToast("اختر الخزنة", "error");
                    return;
                }

                if (!CashBoxes.Any(c => c.cash_box_id == Form.cash_box_id))
                {
                    ToastService.ShowToast("الخزنة غير صالحة، أعد الاختيار", "error");
                    return;
                }
            }

            // 🔥 هنا مباشرة
            if (realPaid == 0 && Form.cash_box_id <= 0)
            {
                var firstCashBox = CashBoxes.FirstOrDefault();

                if (firstCashBox != null)
                    Form.cash_box_id = firstCashBox.cash_box_id;
            }

           

            if (hasError) return;

            // ========================
            // الحسابات
            // ========================
            
            var net = Net;

            if (Payments.Sum(p => p.amount) > net)
            {
                ToastService.ShowToast("المبلغ المدفوع أكبر من الإجمالي", "error");
                return;
            }


            var finalPayments = Payments ?? new List<PaymentInput>();
            var paid = finalPayments.Sum(p => p.amount);     


            var result = await FinanceService.AddOrder(
    Form,
    Form.Items,
    finalPayments,
    CurrentAdminId
);

            if (result.success)
            {
                ToastService.ShowToast("تم الحفظ", "success");

                Payments = new List<PaymentInput>();

                Nav.NavigateTo($"/orders?new={Form.order_id}");
            }
            else
            {
                ToastService.ShowToast(result.message, "error");
            }
        }
        catch (Exception ex)
        {
            var msg = ex.InnerException?.Message ?? ex.Message;
            ToastService.ShowToast(msg, "error");
        }

        finally
        {
            IsSaving = false;
        }
    }

    string Fmt(decimal v) => $"{v:0.00} د.ل";
} 