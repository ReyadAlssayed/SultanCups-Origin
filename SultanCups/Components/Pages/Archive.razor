@page "/Archive"
@layout Layout.MainLayout

@using SultanCups.Models
@using SultanCups.Data
@using Microsoft.EntityFrameworkCore

@inject AppDbContext Db
@using SultanCups.Services
@inject IJSRuntime JS
@inject NavigationManager Nav

<link href="css/Archive.css" rel="stylesheet" />

<div class="archive-page">

    @if (NoAccess)
    {
        <div class="privacy-lock-zone">

            <div class="glass-shield-card no-access-card">

                <div class="lock-anim">⛔</div>

                <h3>سجل الأرشفة</h3>

                <p>
                    هذه الصفحة مخصصة للمسؤول الرئيسي فقط.
                </p>

            </div>

        </div>

        return;
    }

    <div class="emp-topbar">

        <button type="button"
                class="emp-add-btn"
                @onclick='() => Nav.NavigateTo("/Stats")'>

            رجوع

        </button>

        <h2 class="emp-title-center">
            سجل الأرشفة والجرد
        </h2>

        <div style="width:120px;"></div>

    </div>

    @if (Archives == null)
    {
        <div class="empty-state">

            <img src="images/Empty.jpg"
                 class="empty-img" />

            <span>
                لا توجد سجلات أرشفة
            </span>

        </div>
    }
    else if (Archives.Count == 0)
    {
        <div class="empty-state">

            <img src="images/Empty.jpg"
                 class="empty-img" />

            <span>
                لا توجد سجلات أرشفة
            </span>

        </div>
    }
    else
    {
        <div class="archive-cards-grid">

            @foreach (var item in Archives)
            {
                <div class="archive-card">

                    <div class="archive-card-top">

                        <div>

                            <span class="archive-label">
                                رقم الأرشيف
                            </span>

                            <strong>
                                #@item.archive_id
                            </strong>

                        </div>

                        <div class="archive-status">

                            مؤرشف

                        </div>

                    </div>

                    <div class="archive-admin-box">

                        <span class="archive-admin-label">
                            تم تنفيذ الأرشفة بواسطة
                        </span>

                        <strong class="archive-admin-name">

                            @(item.archived_by != null
                            && AdminsNames.ContainsKey(item.archived_by.Value)

                                ? AdminsNames[item.archived_by.Value]

                                : "غير معروف")

                        </strong>

                    </div>

                    <div class="archive-main-stats">

                        <div class="archive-stat">

                            <span>
                                إجمالي السيولة
                            </span>

                            <strong class="blue-text">
                                @Fmt(item.total_cash_balance)
                            </strong>

                        </div>

                        <div class="archive-stat">

                            <span>
                                صافي الوضع المالي
                            </span>

                            <strong class="green-text">
                                @Fmt(item.real_financial_balance)
                            </strong>

                        </div>

                    </div>

                    <div class="archive-mini-grid">

                        <div class="archive-mini-item">

                            <span>
                                بداية الدورة
                            </span>

                            <strong>
                                @(item.from_date
                                    .ToLocalTime()
                                    .ToString("yyyy/MM/dd"))
                            </strong>

                        </div>

                        <div class="archive-mini-item">

                            <span>
                                نهاية الدورة
                            </span>

                            <strong>
                                @(item.to_date
                                    .ToLocalTime()
                                    .ToString("yyyy/MM/dd"))
                            </strong>

                        </div>

                    </div>

                    <div class="archive-card-actions">

                        <button class="archive-details-btn"
                                @onclick="() => OpenDetails(item)">

                            التفاصيل

                        </button>

                    </div>

                </div>
            }

        </div>
    }

</div>

@if (SelectedArchive != null)
{
    <div class="archive-dialog-overlay">

        <div class="archive-dialog archive-dialog-box">

            <div class="archive-dialog-header">

                <div class="archive-logo-wrap">

                    <img src="images/archived.png"
                         class="archive-logo" />

                </div>

                <div class="archive-title-side">

                    <h2>
                        تفاصيل دورة الجرد
                    </h2>

                    <p>

                        @(SelectedArchive.from_date
    .ToLocalTime()
    .ToString("yyyy/MM/dd"))

                        —

                        @(SelectedArchive.to_date
                            .ToLocalTime()
                            .ToString("yyyy/MM/dd"))

                    </p>

                </div>

                <div class="archive-dialog-header-actions">

                    <button class="archive-print-btn"
                            @onclick="PrintArchive">

                        كتابة تقرير جاهز

                    </button>

                    <button class="archive-close-btn"
                            @onclick="CloseDialog">

                        ✕

                    </button>

                </div>

            </div>

            <div class="archive-details-table-wrap">

                <table class="archive-details-table">

                    <tbody>

                        <tr>
                            <td>إجمالي السيولة</td>
                            <td class="blue-text">
                                @Fmt(SelectedArchive.total_cash_balance)
                            </td>

                            <td>صافي الوضع المالي</td>
                            <td>
                                @Fmt(SelectedArchive.real_financial_balance)
                            </td>
                        </tr>

                        <tr>
                            <td>إجمالي الداخل (بدون الرصيد الافتتاحي)</td>
                            <td class="green-text">
                                @Fmt(SelectedArchive.total_in)
                            </td>

                            <td>إجمالي الخارج</td>
                            <td class="red-text">
                                @Fmt(SelectedArchive.total_out)
                            </td>
                        </tr>

                        <tr>
                            <td>إجمالي الديون</td>
                            <td>
                                @Fmt(SelectedArchive.total_debts)
                            </td>

                            <td>المبيعات المحصلة</td>
                            <td>
                                @Fmt(SelectedArchive.total_sales_collected)
                            </td>
                        </tr>

                        <tr>
                            <td>المشتريات</td>
                            <td>
                                @Fmt(SelectedArchive.total_purchases)
                            </td>

                            <td>السلف</td>
                            <td>
                                @Fmt(SelectedArchive.total_loans)
                            </td>
                        </tr>

                        <tr>
                            <td>السلف غير المسددة</td>
                            <td>
                                @Fmt(SelectedArchive.loans_remaining)
                            </td>

                            <td>الرواتب المستحقة</td>
                            <td>
                                @Fmt(SelectedArchive.salaries_remaining)
                            </td>
                        </tr>

                        <tr>
                            <td>العمولات غير المدفوعة</td>
                            <td>
                                @Fmt(SelectedArchive.commissions_unpaid)
                            </td>

                            <td></td>
                            <td></td>
                        </tr>

                        <tr>
                            <td>عدد الموظفين</td>
                            <td>
                                @SelectedArchive.employees_count
                            </td>

                            <td>إجمالي الإنتاج</td>
                            <td>
                                @SelectedArchive.total_production_quantity
                            </td>
                        </tr>

                        <tr>
                            <td>عدد المرجوعات</td>
                            <td>
                                @SelectedArchive.total_returns_count
                            </td>

                            <td>الصناديق الراجعة</td>
                            <td>
                                @SelectedArchive.total_returns_boxes
                            </td>
                        </tr>

                        <tr>
                            <td>أفضل مسوق</td>
                            <td>
                                @(SelectedArchive.best_marketer_name ?? "-")
                            </td>

                            <td>أفضل زبون</td>
                            <td>
                                @(SelectedArchive.best_customer_name ?? "-")
                            </td>
                        </tr>

                        <tr>
                            <td>أفضل مورد</td>
                            <td>
                                @(SelectedArchive.best_supplier_name ?? "-")
                            </td>

                            <td>الأكثر مبيعًا</td>
                            <td>
                                @(SelectedArchive.most_sold_product_name ?? "-")
                            </td>
                        </tr>

                        <tr>
                            <td>الأكثر إنتاجًا</td>

                            <td>
                                @(SelectedArchive.most_produced_product_name ?? "-")
                            </td>

                            <td></td>

                            <td></td>
                        </tr>
                    </tbody>

                </table>

            </div>

          

        </div>

    </div>
}

@code {

    [Inject] UserSession Session { get; set; } = default!;

    bool NoAccess = false;

    List<ArchiveCycle> Archives = new();

    ArchiveCycle? SelectedArchive;
    Dictionary<int, string> AdminsNames = new();

    protected override async Task OnInitializedAsync()
    {
        if (Session.Role != "Admin1")
        {
            NoAccess = true;
            return;
        }

        await RefreshArchives();
    }

    async Task RefreshArchives()
    {
        Archives =
            await Db.archive_cycles
                .AsNoTracking()
                .OrderByDescending(x => x.archive_id)
                .ToListAsync();

        AdminsNames =
            await Db.admins
                .AsNoTracking()
                .ToDictionaryAsync(
                    x => x.admin_id,
                    x => x.full_name
                );
    }

    void OpenDetails(ArchiveCycle item)
    {
        SelectedArchive = item;
    }

    void CloseDialog()
    {
        SelectedArchive = null;
    }

    async Task PrintArchive()
    {
        await JS.InvokeVoidAsync(
            "printArchiveDetails");
    }

    string Fmt(decimal value)
    {
        if (value % 1 == 0)
            return $"{value:N0} د.ل";

        return $"{value:N2} د.ل";
    }
}