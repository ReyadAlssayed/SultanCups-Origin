@page "/Archive"
@layout Layout.MainLayout

@using SultanCups.Models
@using SultanCups.Data
@using Microsoft.EntityFrameworkCore

@inject AppDbContext Db
@inject IJSRuntime JS

<div class="emp-page">

    <div class="emp-topbar">

        <div></div>

        <h2 class="emp-title-center">
            سجل الأرشفة والجرد
        </h2>

        <button class="pro-btn-excel"
                @onclick="RefreshArchives">

            تحديث

        </button>

    </div>

    <div class="emp-card">

        <div class="emp-table-wrap">

            <table class="emp-table">

                <thead>

                    <tr>

                        <th>#</th>

                        <th>تاريخ الجرد</th>

                        <th>إجمالي السيولة</th>

                        <th>إجمالي الداخل</th>

                        <th>إجمالي الخارج</th>

                        <th>الديون</th>

                        <th>الإجراءات</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Archives == null)
                    {
                        <tr>

                            <td colspan="7">

                                جاري التحميل...

                            </td>

                        </tr>
                    }
                    else if (Archives.Count == 0)
                    {
                        <tr>

                            <td colspan="7" class="st-empty-text">

                                <div class="empty-state">

                                    <img src="images/Empty.jpg"
                                         class="empty-img" />

                                    <span>
                                        لا توجد سجلات أرشفة
                                    </span>

                                </div>

                            </td>

                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Archives)
                        {
                            <tr>

                                <td>
                                    @item.archive_id
                                </td>

                                <td>

                                    @item.archive_date
                                    .ToLocalTime()
                                    .ToString("yyyy/MM/dd hh:mm tt")

                                </td>

                                <td>
                                    @Fmt(item.total_cash_balance)
                                </td>

                                <td class="green-text">
                                    @Fmt(item.total_in)
                                </td>

                                <td class="red-text">
                                    @Fmt(item.total_out)
                                </td>

                                <td>
                                    @Fmt(item.total_debts)
                                </td>

                                <td class="emp-actions">

                                    <button type="button"
                                            class="emp-edit"
                                            @onclick="() => OpenDetails(item)">

                                        التفاصيل

                                    </button>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@if (SelectedArchive != null)
{
    <div class="emp-dialog-overlay">

        <div class="emp-dialog-box archive-dialog-box">

            <div class="emp-dialog-top-image">

                <img src="images/background.png" />

            </div>

            <div class="emp-dialog-body">

                <h3 class="emp-dialog-title">

                    تفاصيل دورة الجرد

                </h3>

                <div class="archive-details-grid">

                    <div class="archive-detail-card">

                        <span>
                            رقم الأرشيف
                        </span>

                        <strong>
                            @SelectedArchive.archive_id
                        </strong>

                    </div>

                    <div class="archive-detail-card">

                        <span>
                            تاريخ الأرشفة
                        </span>

                        <strong>

                            @SelectedArchive.archive_date
                            .ToLocalTime()
                            .ToString("yyyy/MM/dd hh:mm tt")

                        </strong>

                    </div>

                    <div class="archive-detail-card">

                        <span>
                            إجمالي السيولة
                        </span>

                        <strong>
                            @Fmt(SelectedArchive.total_cash_balance)
                        </strong>

                    </div>

                    <div class="archive-detail-card">

                        <span>
                            صافي الوضع المالي
                        </span>

                        <strong>
                            @Fmt(SelectedArchive.real_financial_balance)
                        </strong>

                    </div>

                    <div class="archive-detail-card">

                        <span>
                            إجمالي الداخل
                        </span>

                        <strong class="green-text">
                            @Fmt(SelectedArchive.total_in)
                        </strong>

                    </div>

                    <div class="archive-detail-card">

                        <span>
                            إجمالي الخارج
                        </span>

                        <strong class="red-text">
                            @Fmt(SelectedArchive.total_out)
                        </strong>

                    </div>

                    <div class="archive-detail-card">

                        <span>
                            الديون
                        </span>

                        <strong>
                            @Fmt(SelectedArchive.total_debts)
                        </strong>

                    </div>

                    <div class="archive-detail-card">

                        <span>
                            المبيعات المحصلة
                        </span>

                        <strong>
                            @Fmt(SelectedArchive.total_sales_collected)
                        </strong>

                    </div>

                    <div class="archive-detail-card">

                        <span>
                            المشتريات
                        </span>

                        <strong>
                            @Fmt(SelectedArchive.total_purchases)
                        </strong>

                    </div>

                    <div class="archive-detail-card">

                        <span>
                            السلف
                        </span>

                        <strong>
                            @Fmt(SelectedArchive.total_loans)
                        </strong>

                    </div>

                    <div class="archive-detail-card">

                        <span>
                            الرواتب المدفوعة
                        </span>

                        <strong>
                            @Fmt(SelectedArchive.salaries_paid)
                        </strong>

                    </div>

                    <div class="archive-detail-card">

                        <span>
                            الرواتب المستحقة
                        </span>

                        <strong>
                            @Fmt(SelectedArchive.salaries_remaining)
                        </strong>

                    </div>

                    <div class="archive-detail-card">

                        <span>
                            العمولات المدفوعة
                        </span>

                        <strong>
                            @Fmt(SelectedArchive.commissions_paid)
                        </strong>

                    </div>

                    <div class="archive-detail-card">

                        <span>
                            العمولات المستحقة
                        </span>

                        <strong>
                            @Fmt(SelectedArchive.commissions_unpaid)
                        </strong>

                    </div>

                    <div class="archive-detail-card">

                        <span>
                            عدد الموظفين
                        </span>

                        <strong>
                            @SelectedArchive.employees_count
                        </strong>

                    </div>

                    <div class="archive-detail-card">

                        <span>
                            إجمالي الإنتاج
                        </span>

                        <strong>
                            @SelectedArchive.total_production_quantity
                        </strong>

                    </div>

                    <div class="archive-detail-card">

                        <span>
                            عدد المرجوعات
                        </span>

                        <strong>
                            @SelectedArchive.total_returns_count
                        </strong>

                    </div>

                    <div class="archive-detail-card">

                        <span>
                            الصناديق الراجعة
                        </span>

                        <strong>
                            @SelectedArchive.total_returns_boxes
                        </strong>

                    </div>

                    <div class="archive-detail-card">

                        <span>
                            أفضل مسوق
                        </span>

                        <strong>
                            @(SelectedArchive.best_marketer_name ?? "-")
                        </strong>

                    </div>

                    <div class="archive-detail-card">

                        <span>
                            أفضل زبون
                        </span>

                        <strong>
                            @(SelectedArchive.best_customer_name ?? "-")
                        </strong>

                    </div>

                    <div class="archive-detail-card">

                        <span>
                            أفضل مورد
                        </span>

                        <strong>
                            @(SelectedArchive.best_supplier_name ?? "-")
                        </strong>

                    </div>

                    <div class="archive-detail-card">

                        <span>
                            الأكثر مبيعًا
                        </span>

                        <strong>
                            @(SelectedArchive.most_sold_product_name ?? "-")
                        </strong>

                    </div>

                    <div class="archive-detail-card">

                        <span>
                            الأكثر إنتاجًا
                        </span>

                        <strong>
                            @(SelectedArchive.most_produced_product_name ?? "-")
                        </strong>

                    </div>

                </div>

                <div class="emp-dialog-actions">

                    <button type="button"
                            class="emp-save"
                            @onclick="PrintArchive">

                        طباعة PDF

                    </button>

                    <button type="button"
                            class="emp-cancel"
                            @onclick="CloseDialog">

                        إغلاق

                    </button>

                </div>

            </div>

        </div>

    </div>
}

@code {

    List<ArchiveCycle> Archives = new();

    ArchiveCycle? SelectedArchive;

    protected override async Task OnInitializedAsync()
    {
        await RefreshArchives();
    }

    async Task RefreshArchives()
    {
        Archives =
            await Db.archive_cycles
                .AsNoTracking()
                .OrderByDescending(x => x.archive_id)
                .ToListAsync();
    }

    void OpenDetails(ArchiveCycle item)
    {
        SelectedArchive = item;
    }

    void CloseDialog()
    {
        SelectedArchive = null;
    }

    async Task PrintArchive()
    {
        await JS.InvokeVoidAsync(
            "printArchiveDetails");
    }

    string Fmt(decimal value)
    {
        if (value % 1 == 0)
            return $"{value:N0} د.ل";

        return $"{value:N2} د.ل";
    }
}