@page "/Stats"
@layout Layout.MainLayout

@using SultanCups.Models
@using SultanCups.Services

@inject StatsAndArchiveService StatsService

<div class="stats-page-container">

    @if (NoAccess)
    {
        <div class="privacy-lock-zone">

            <div class="glass-shield-card no-access-card">

                <div class="lock-anim">⛔</div>

                <h3>لوحة الإحصائيات</h3>

                <p>
                    تم تخصيص هذه الصفحة للمسؤول الرئيسي فقط،
                    بينما يمكنك متابعة بقية أقسام النظام بشكل طبيعي.
                </p>

            </div>

        </div>
    }
    else
    {

        @if (!isDataVisible)
        {
            <div class="privacy-lock-zone">

                <div class="glass-shield-card">

                    <div class="lock-anim">🔒</div>

                    <h3>إحصائيات الإدارة</h3>

                    <p>بيانات مالية حساسة ومحمية</p>

                    <button class="btn-reveal"
                            @onclick="LoadStats"
                            disabled="@isLoadingStats">

                        @if (isLoadingStats)
                        {
                            <span class="btn-loader"></span>
                        }
                        else
                        {
                            <span>كشف البيانات</span>
                        }

                    </button>

                </div>

            </div>
        }

        <div class="stats-scrollable-content @(isDataVisible ? "content-active" : "content-blurred")">

            <!-- HEADER -->

            <div class="stats-top-bar">

                <div class="welcome-msg">

                    <h1>لوحة التحكم المالي</h1>

                    <p>
                        إحصائيات تراكمية حقيقية منذ آخر جرد
                    </p>

                </div>

                <div class="top-actions">

                    <button class="btn-hide-ui"
                            @onclick="() => isDataVisible = false">

                        إخفاء البيانات

                    </button>

                    <button class="btn-archive-ui">

                        تنفيذ جرد وأرشفة

                    </button>

                   

                </div>

            </div>

            <!-- البطاقات -->

            <div class="summary-grid">

                <div class="mini-card">

                    <div class="card-icon"></div>

                    <div class="card-data">

                        <span class="label">
                            إجمالي السيولة
                        </span>

                        <span class="value">
                            @Fmt(DashboardStats.total_cash_balance)
                        </span>

                    </div>

                </div>

                <div class="mini-card">

                    <div class="card-icon"></div>

                    <div class="card-data">

                        <span class="label">
                            صافي الوضع المالي الحالي
                        </span>

                        <span class="value">
                            @Fmt(DashboardStats.real_financial_balance)
                        </span>

                    </div>

                </div>

                <div class="mini-card">

                    <div class="card-icon"></div>

                    <div class="card-data">

                        <span class="label">
                            إجمالي الديون
                        </span>

                        <span class="value">
                            @Fmt(DashboardStats.total_debts)
                        </span>

                    </div>

                </div>

                <div class="mini-card">

                    <div class="card-icon"></div>

                    <div class="card-data">

                        <span class="label">
                            إجمالي الداخل
                        </span>

                        <span class="value green-text">
                            @Fmt(DashboardStats.total_in)
                        </span>

                    </div>

                </div>

                <div class="mini-card">

                    <div class="card-icon"></div>

                    <div class="card-data">

                        <span class="label">
                            إجمالي الخارج
                        </span>

                        <span class="value red-text">
                            @Fmt(DashboardStats.total_out)
                        </span>

                    </div>

                </div>

                <div class="mini-card">

                    <div class="card-icon"></div>

                    <div class="card-data">

                        <span class="label">
                            المبيعات المحصلة
                        </span>

                        <span class="value">
                            @Fmt(DashboardStats.total_sales_collected)
                        </span>

                    </div>

                </div>

                <div class="mini-card">

                    <div class="card-icon"></div>

                    <div class="card-data">

                        <span class="label">
                            إجمالي المشتريات
                        </span>

                        <span class="value">
                            @Fmt(DashboardStats.total_purchases)
                        </span>

                    </div>

                </div>

                <div class="mini-card">

                    <div class="card-icon"></div>

                    <div class="card-data">

                        <span class="label">
                            إجمالي السلف
                        </span>

                        <span class="value">
                            @Fmt(DashboardStats.total_loans)
                        </span>

                    </div>

                </div>

                <div class="mini-card">

                    <div class="card-icon"></div>

                    <div class="card-data">

                        <span class="label">
                            عدد الموظفين
                        </span>

                        <span class="value">
                            @DashboardStats.employees_count
                        </span>

                    </div>

                </div>

                <div class="mini-card">

                    <div class="card-icon"></div>

                    <div class="card-data">

                        <span class="label">
                            إجمالي الإنتاج
                        </span>

                        <span class="value">
                            @DashboardStats.total_production_quantity
                        </span>

                    </div>

                </div>

                <div class="mini-card">

                    <div class="card-icon"></div>

                    <div class="card-data">

                        <span class="label">
                            عدد المرجوعات
                        </span>

                        <span class="value">
                            @DashboardStats.total_returns_count
                        </span>

                    </div>

                </div>

                <div class="mini-card">

                    <div class="card-icon"></div>

                    <div class="card-data">

                        <span class="label">
                            الصناديق الراجعة
                        </span>

                        <span class="value">
                            @DashboardStats.total_returns_boxes
                        </span>

                    </div>

                </div>

            </div>

            <!-- أفضل العناصر -->

            <div class="stats-section">

                <h3>أفضل العناصر</h3>

                <div class="top-stats-grid">

                    @if (DashboardStats.best_marketer != null)
                    {
                        <div class="top-stat-card">

                            <h4>أفضل مسوق</h4>

                            <span>
                                @DashboardStats.best_marketer.marketer_name
                            </span>

                            <small>
                                @Fmt(DashboardStats.best_marketer.total_sales)
                            </small>

                        </div>
                    }

                    @if (DashboardStats.best_customer != null)
                    {
                        <div class="top-stat-card">

                            <h4>أفضل زبون</h4>

                            <span>
                                @DashboardStats.best_customer.customer_name
                            </span>

                            <small>
                                @Fmt(DashboardStats.best_customer.total_sales)
                            </small>

                        </div>
                    }

                    @if (DashboardStats.best_supplier != null)
                    {
                        <div class="top-stat-card">

                            <h4>أفضل مورد</h4>

                            <span>
                                @DashboardStats.best_supplier.supplier_name
                            </span>

                            <small>
                                @Fmt(DashboardStats.best_supplier.total_purchases)
                            </small>

                        </div>
                    }

                </div>

            </div>

            <!-- المنتجات -->

            <div class="stats-section">

                <h3>المنتجات</h3>

                <div class="top-stats-grid">

                    @if (DashboardStats.most_sold_product != null)
                    {
                        <div class="top-stat-card">

                            <h4>الأكثر مبيعًا</h4>

                            <span>
                                @DashboardStats.most_sold_product.product_name
                            </span>

                            <small>
                                @DashboardStats.most_sold_product.quantity صندوق
                            </small>

                        </div>
                    }

                    @if (DashboardStats.most_produced_product != null)
                    {
                        <div class="top-stat-card">

                            <h4>الأكثر إنتاجًا</h4>

                            <span>
                                @DashboardStats.most_produced_product.product_name
                            </span>

                            <small>
                                @DashboardStats.most_produced_product.quantity صندوق
                            </small>

                        </div>
                    }

                </div>

            </div>

            <!-- الخزنات -->

            <div class="stats-section">

                <h3>الخزنات</h3>

                <div class="stats-table-wrapper">

                    <table class="stats-table">

                        <thead>

                            <tr>

                                <th>الخزنة</th>
                                <th>الرصيد الحالي</th>
                                <th>إجمالي الداخل</th>
                                <th>إجمالي الخارج</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in DashboardStats.cash_boxes)
                            {
                                <tr>

                                    <td>@item.cash_box_name</td>

                                    <td>
                                        @Fmt(item.current_balance)
                                    </td>

                                    <td class="green-text">
                                        @Fmt(item.total_in)
                                    </td>

                                    <td class="red-text">
                                        @Fmt(item.total_out)
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>

@code {

    private bool isDataVisible = false;

    bool NoAccess = false;

    private StatsView DashboardStats = new();

    private bool isLoadingStats = false;

    [Inject] UserSession Session { get; set; } = default!;

    private async Task LoadStats()
    {
        isDataVisible = true;

        if (DashboardStats.total_cash_balance > 0)
            return;

        isLoadingStats = true;

        DashboardStats =
            await StatsService.GetDashboardStats();

        isLoadingStats = false;
    }

    protected override void OnInitialized()
    {
        if (Session.Role != "Admin1")
        {
            NoAccess = true;
            return;
        }
    }

    string Fmt(decimal value)
    {
        if (value % 1 == 0)
            return $"{value:N0} د.ل";

        return $"{value:N2} د.ل";
    }
}