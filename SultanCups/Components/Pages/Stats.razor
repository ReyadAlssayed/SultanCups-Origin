@page "/Stats"
@layout Layout.MainLayout

@using SultanCups.Models
@using SultanCups.Services

@inject StatsAndArchiveService StatsService



    <div class="stats-page-container">

    @if (NoAccess)
    {
        <div class="privacy-lock-zone">

            <div class="glass-shield-card no-access-card">

                <div class="lock-anim">⛔</div>

                <h3>صلاحية غير متاحة</h3>

                <p>
                    هذه الصفحة مخصصة للمسؤول الأول فقط،
                    ولا تملك صلاحية الوصول إلى الإحصائيات المالية.
                </p>

            </div>

        </div>
    }
    else
    {
        @if (!isDataVisible)
        {
            <div class="privacy-lock-zone">
                <div class="glass-shield-card">

                    <div class="lock-anim">🔒</div>

                    <h3>إحصائيات الإدارة</h3>

                    <p>بيانات مالية حساسة ومحمية</p>

                    <button class="btn-reveal"
                    @onclick="LoadStats"
                    disabled="@isLoadingStats">

                        @if (isLoadingStats)
                        {
                            <span class="btn-loader"></span>
                        }
                        else
                        {
                            <span>كشف البيانات</span>
                        }

                    </button>

                </div>
            </div>
        }

        <div class="stats-scrollable-content @(isDataVisible ? "content-active" : "content-blurred")">


            <!-- HEADER -->

            <div class="stats-top-bar">

                <div class="welcome-msg">

                    <h1>لوحة التحكم المالي</h1>

                    <p>نظرة عامة على الأداء والسيولة</p>

                </div>

                <button class="btn-hide-ui"
                @onclick="() => isDataVisible = false">
                    إخفاء البيانات
                </button>

            </div>

            <!-- SUMMARY -->

            <div class="summary-grid">

                <div class="mini-card">

                    <div class="card-icon">💰</div>

                    <div class="card-data">

                        <span class="label">
                            صافي الربح الشهري
                        </span>

                        <span class="value">
                            @Fmt(DashboardStats.monthly_profit)
                        </span>

                    </div>

                </div>

                <div class="mini-card">

                    <div class="card-icon">📦</div>

                    <div class="card-data">

                        <span class="label">
                            الصناديق المباعة
                        </span>

                        <span class="value">
                            @DashboardStats.monthly_boxes_sold
                        </span>

                    </div>

                </div>

                <div class="mini-card">

                    <div class="card-icon">🧾</div>

                    <div class="card-data">

                        <span class="label">
                            عدد الفواتير
                        </span>

                        <span class="value">
                            @DashboardStats.monthly_orders_count
                        </span>

                    </div>

                </div>

                <div class="mini-card">

                    <div class="card-icon">🚨</div>

                    <div class="card-data">

                        <span class="label">
                            إجمالي الديون
                        </span>

                        <span class="value">
                            @Fmt(DashboardStats.total_debts)
                        </span>

                    </div>

                </div>

                <div class="mini-card">

                    <div class="card-icon">🏦</div>

                    <div class="card-data">

                        <span class="label">
                            إجمالي السيولة
                        </span>

                        <span class="value">
                            @Fmt(DashboardStats.total_cash_balance)
                        </span>

                    </div>

                </div>

            </div>

            <!-- توزيع المبيعات -->

            <div class="stats-section">

                <h3>توزيع المبيعات</h3>

                <div class="stats-table-wrapper">

                    <table class="stats-table">

                        <thead>

                            <tr>

                                <th>المنتج</th>

                                <th>الكمية</th>

                                <th>النسبة</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in DashboardStats.sales_distribution)
                            {
                                <tr>

                                    <td>@item.product_name</td>

                                    <td>@item.quantity</td>

                                    <td>@item.percentage %</td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

            <!-- الخزنات -->

            <div class="stats-section">

                <h3>الخزنات</h3>

                <div class="stats-table-wrapper">

                    <table class="stats-table">

                        <thead>

                            <tr>

                                <th>الخزنة</th>

                                <th>الرصيد الحالي</th>

                                <th>الدخل الشهري</th>

                                <th>الخروج الشهري</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in DashboardStats.cash_boxes)
                            {
                                <tr>

                                    <td>@item.cash_box_name</td>

                                    <td>@Fmt(item.current_balance)</td>

                                    <td class="green-text">
                                        @Fmt(item.monthly_in)
                                    </td>

                                    <td class="red-text">
                                        @Fmt(item.monthly_out)
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

            <!-- ديون الزبائن -->

            <div class="stats-section">

                <h3>ديون الزبائن</h3>

                <div class="stats-table-wrapper">

                    <table class="stats-table">

                        <thead>

                            <tr>

                                <th>الزبون</th>

                                <th>قيمة الدين</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in DashboardStats.customer_debts)
                            {
                                <tr>

                                    <td>@item.customer_name</td>

                                    <td class="red-text">
                                        @Fmt(item.debt_amount)
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

            <!-- ديون المسوقين -->

            <div class="stats-section">

                <h3>ديون المسوقين</h3>

                <div class="stats-table-wrapper">

                    <table class="stats-table">

                        <thead>

                            <tr>

                                <th>المسوق</th>

                                <th>قيمة الدين</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in DashboardStats.marketer_debts)
                            {
                                <tr>

                                    <td>@item.marketer_name</td>

                                    <td class="red-text">
                                        @Fmt(item.debt_amount)
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

            <!-- المنتجات الناقصة -->

            <div class="stats-section">

                <h3>المنتجات الناقصة</h3>

                <div class="stats-table-wrapper">

                    <table class="stats-table">

                        <thead>

                            <tr>

                                <th>المنتج</th>

                                <th>الكمية الحالية</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in DashboardStats.low_stock_products)
                            {
                                <tr>

                                    <td>@item.product_name</td>

                                    <td class="red-text">
                                        @item.current_quantity
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

            <!-- أفضل المسوقين -->

            <div class="stats-section">

                <h3>أفضل المسوقين</h3>

                <div class="stats-table-wrapper">

                    <table class="stats-table">

                        <thead>

                            <tr>

                                <th>المسوق</th>

                                <th>عدد الفواتير</th>

                                <th>إجمالي البيع</th>

                                <th>إجمالي العمولات</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in DashboardStats.top_marketers)
                            {
                                <tr>

                                    <td>@item.marketer_name</td>

                                    <td>@item.orders_count</td>

                                    <td>@Fmt(item.total_sales)</td>

                                    <td>@Fmt(item.total_commissions)</td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>


        </div>
    }


        </div>

    


@code {

    private bool isDataVisible = false;
    bool NoAccess = false;

    private StatsView DashboardStats = new();

    private bool isLoadingStats = false;

    [Inject] UserSession Session { get; set; } = default!;

    [Inject] NavigationManager Nav { get; set; } = default!;

    private async Task LoadStats()
    {
        isDataVisible = true;

        if (DashboardStats.monthly_orders_count > 0)
            return;

        isLoadingStats = true;

        DashboardStats =
            await StatsService.GetDashboardStats();

        isLoadingStats = false;
    }

    protected override void OnInitialized()
    {
        if (Session.Role != "Admin1")
        {
            NoAccess = true;

            return;
        }
    }

    string Fmt(decimal value)
    {
        return $"{value:N2} د.ل";
    }
}