@page "/Stats"
@layout Layout.MainLayout
@inject IJSRuntime JS

@using SultanCups.Models
@using SultanCups.Services

@inject StatsAndArchiveService StatsService

<div class="stats-page-container">

    @if (NoAccess)
    {
        <div class="privacy-lock-zone">

            <div class="glass-shield-card no-access-card">

                <div class="lock-anim">⛔</div>

                <h3>لوحة الإحصائيات</h3>

                <p>
                    تم تخصيص هذه الصفحة للمسؤول الرئيسي فقط،
                    بينما يمكنك متابعة بقية أقسام النظام بشكل طبيعي.
                </p>

            </div>

        </div>
    }
    else
    {

        @if (!isDataVisible)
        {
            <div class="privacy-lock-zone">

                <div class="glass-shield-card">

                    <div class="lock-anim">🔒</div>

                    <h3>إحصائيات الإدارة</h3>

                    <p>بيانات مالية حساسة ومحمية</p>

                    <button class="btn-reveal"
                            @onclick="LoadStats"
                            disabled="@isLoadingStats">

                        @if (isLoadingStats)
                        {
                            <span class="btn-loader"></span>
                        }
                        else
                        {
                            <span>كشف البيانات</span>
                        }

                    </button>

                </div>

            </div>
        }

        <div class="stats-scrollable-content @(isDataVisible ? "content-active" : "content-blurred")">

            <!-- HEADER -->

            <div class="stats-top-bar">

                <div class="welcome-msg">

                    <h1>لوحة التحكم المالي</h1>

                    <p>
                        إحصائيات تراكمية حقيقية منذ آخر جرد
                    </p>

                </div>

                <div class="top-actions">

                    <button class="btn-hide-ui"
                            @onclick="() => isDataVisible = false">

                        إخفاء البيانات

                    </button>

                    <button class="btn-archive-ui"
                            @onclick="OpenArchiveDialog">

                        تنفيذ جرد وأرشفة

                    </button>

                    <button class="btn-archive-ui"
                            @onclick="PrintStatsPdf">

                        طباعة PDF

                    </button>

                   

                </div>

            </div>

            <!-- البطاقات -->

            <div class="summary-grid">

                <div class="mini-card">

                    <div class="card-icon"></div>

                    <div class="card-data">

                        <span class="label">
                            إجمالي السيولة
                        </span>

                        <span class="value">
                            @Fmt(DashboardStats.total_cash_balance)
                        </span>

                    </div>

                </div>

                <div class="mini-card">

                    <div class="card-icon"></div>

                    <div class="card-data">

                        <span class="label">
                            صافي الوضع المالي الحالي
                        </span>

                        <span class="value">
                            @Fmt(DashboardStats.real_financial_balance)
                        </span>

                    </div>

                </div>

                <div class="mini-card">

                    <div class="card-icon"></div>

                    <div class="card-data">

                        <span class="label">
                            إجمالي الديون
                        </span>

                        <span class="value">
                            @Fmt(DashboardStats.total_debts)
                        </span>

                    </div>

                </div>

                <div class="mini-card">

                    <div class="card-icon"></div>

                    <div class="card-data">

                        <span class="label">
                            إجمالي الداخل
                        </span>

                        <span class="value green-text">
                            @Fmt(DashboardStats.total_in)
                        </span>

                    </div>

                </div>

                <div class="mini-card">

                    <div class="card-icon"></div>

                    <div class="card-data">

                        <span class="label">
                            إجمالي الخارج
                        </span>

                        <span class="value red-text">
                            @Fmt(DashboardStats.total_out)
                        </span>

                    </div>

                </div>

                <div class="mini-card">

                    <div class="card-icon"></div>

                    <div class="card-data">

                        <span class="label">
                            المبيعات المحصلة
                        </span>

                        <span class="value">
                            @Fmt(DashboardStats.total_sales_collected)
                        </span>

                    </div>

                </div>

                <div class="mini-card">

                    <div class="card-icon"></div>

                    <div class="card-data">

                        <span class="label">
                            إجمالي المشتريات
                        </span>

                        <span class="value">
                            @Fmt(DashboardStats.total_purchases)
                        </span>

                    </div>

                </div>

                <div class="mini-card">

                    <div class="card-icon"></div>

                    <div class="card-data">

                        <span class="label">
                            إجمالي السلف
                        </span>

                        <span class="value">
                            @Fmt(DashboardStats.total_loans)
                        </span>

                    </div>

                </div>

                <div class="mini-card">

                    <div class="card-icon"></div>

                    <div class="card-data">

                        <span class="label">
                            السلف غير المسددة
                        </span>

                        <span class="value red-text">
                            @Fmt(DashboardStats.loans_remaining)
                        </span>

                    </div>

                </div>

                <div class="mini-card">

                    <div class="card-icon"></div>

                    <div class="card-data">

                        <span class="label">
                            عدد الموظفين
                        </span>

                        <span class="value">
                            @DashboardStats.employees_count
                        </span>

                    </div>

                </div>

                <div class="mini-card">

                    <div class="card-icon"></div>

                    <div class="card-data">

                        <span class="label">
                            إجمالي الإنتاج
                        </span>

                        <span class="value">
                            @DashboardStats.total_production_quantity
                        </span>

                    </div>

                </div>

                <div class="mini-card">

                    <div class="card-icon"></div>

                    <div class="card-data">

                        <span class="label">
                            عدد المرجوعات
                        </span>

                        <span class="value">
                            @DashboardStats.total_returns_count
                        </span>

                    </div>

                </div>

                <div class="mini-card">

                    <div class="card-icon"></div>

                    <div class="card-data">

                        <span class="label">
                            الصناديق الراجعة
                        </span>

                        <span class="value">
                            @DashboardStats.total_returns_boxes
                        </span>

                    </div>

                </div>

            </div>

            <div class="stats-section">

                <h3>أفضل العناصر</h3>

                <div class="top-stats-grid">

                    <div class="top-stat-card">

                        <h4>أفضل مسوق</h4>

                        <span>
                            @(DashboardStats.best_marketer?.marketer_name ?? "-")
                        </span>

                        <small>
                            @(DashboardStats.best_marketer != null
                                ? Fmt(DashboardStats.best_marketer.total_sales)
                                : "0 د.ل")
                        </small>

                    </div>

                    <div class="top-stat-card">

                        <h4>أفضل زبون</h4>

                        <span>
                            @(DashboardStats.best_customer?.customer_name ?? "-")
                        </span>

                        <small>
                            @(DashboardStats.best_customer != null
                                ? Fmt(DashboardStats.best_customer.total_sales)
                                : "0 د.ل")
                        </small>

                    </div>

                    <div class="top-stat-card">

                        <h4>أفضل مورد</h4>

                        <span>
                            @(DashboardStats.best_supplier?.supplier_name ?? "-")
                        </span>

                        <small>
                            @(DashboardStats.best_supplier != null
                                ? Fmt(DashboardStats.best_supplier.total_purchases)
                                : "0 د.ل")
                        </small>

                    </div>

                </div>

            </div>

            <!-- المنتجات -->

            <div class="stats-section">

                <h3>المنتجات</h3>

                <div class="top-stats-grid">

                    <div class="top-stat-card">

                        <h4>الأكثر مبيعًا</h4>

                        <span>
                            @(DashboardStats.most_sold_product?.product_name ?? "-")
                        </span>

                        <small>
                            @(DashboardStats.most_sold_product != null
                                ? $"{DashboardStats.most_sold_product.quantity} صندوق"
                                : "0 صندوق")
                        </small>

                    </div>

                    <div class="top-stat-card">

                        <h4>الأكثر إنتاجًا</h4>

                        <span>
                            @(DashboardStats.most_produced_product?.product_name ?? "-")
                        </span>

                        <small>
                            @(DashboardStats.most_produced_product != null
                                ? $"{DashboardStats.most_produced_product.quantity} صندوق"
                                : "0 صندوق")
                        </small>

                    </div>

                </div>

            </div>

            <!-- الخزنات -->

            <div class="stats-section">

                <h3>الخزنات</h3>

                <div class="stats-table-wrapper">

                    <table class="stats-table">

                        <thead>

                            <tr>

                                <th>الخزنة</th>
                                <th>الرصيد الحالي</th>
                                <th>إجمالي الداخل</th>
                                <th>إجمالي الخارج</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in DashboardStats.cash_boxes)
                            {
                                <tr>

                                    <td>@item.cash_box_name</td>

                                    <td>
                                        @Fmt(item.current_balance)
                                    </td>

                                    <td class="green-text">
                                        @Fmt(item.total_in)
                                    </td>

                                    <td class="red-text">
                                        @Fmt(item.total_out)
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>

@if (showArchiveDialog)
{
    <div class="pro-dialog-overlay">

        <div class="sal-dialog-box archive-dialog">

            <h3>
                تأكيد تنفيذ الجرد والأرشفة
            </h3>

            <p>
                تأكد من:
                <br />
                • أرشفة ملفات Excel
                <br />
                • أخذ نسخة احتياطية
                <br />
                • تصفية جميع الحسابات
                <br /><br />
                سيتم بدء دورة إحصائية جديدة بعد الجرد.
            </p>

            <div class="archive-dates-box">

                <div>

                    <span>من تاريخ:</span>

                    <strong>
                        @archiveFromDate
                    </strong>

                </div>

                <div>

                    <span>إلى تاريخ:</span>

                    <strong>
                        @archiveToDate
                    </strong>

                </div>

            </div>

            <div class="pro-dialog-actions">

                <button class="btn-cancel"
                        @onclick="() => showArchiveDialog = false">

                    إلغاء

                </button>

                <button class="btn-save"
                        @onclick="ConfirmArchive">

                    تنفيذ الأرشفة

                </button>

            </div>

        </div>

    </div>
}

@code {

    private bool isDataVisible = false;

    bool NoAccess = false;

    private StatsView DashboardStats = new();

    private bool isLoadingStats = false;

    [Inject] UserSession Session { get; set; } = default!;

    bool showArchiveDialog = false;

    string archiveFromDate = "";

    string archiveToDate = "";

    private async Task LoadStats()
    {
        isDataVisible = true;


        isLoadingStats = true;

        DashboardStats =
            await StatsService.GetDashboardStats();

        isLoadingStats = false;
    }

    protected override void OnInitialized()
    {
        if (Session.Role != "Admin1")
        {
            NoAccess = true;
            return;
        }
    }

    async Task PrintStatsPdf()
    {
        StateHasChanged();

        await Task.Delay(1200);

        await JS.InvokeVoidAsync("printStatsCard");
    }

    async Task ConfirmArchive()
    {
        var result =
            await StatsService
                .ArchiveCurrentCycle(Session.AdminId);

        if (!result.success)
        {
            await JS.InvokeVoidAsync(
                "alert",
                result.toDate);

            return;
        }

        showArchiveDialog = false;

        await JS.InvokeVoidAsync(
    "alert",
    "تم تنفيذ الجرد والأرشفة بنجاح");

        DashboardStats =
            await StatsService.GetDashboardStats();
    }

    async Task OpenArchiveDialog()
    {
        DateTime lastArchiveDate =

            await StatsService
                .GetLastArchiveDate();

        if (lastArchiveDate == default)
        {
            lastArchiveDate =
    DateTime.SpecifyKind(
        new DateTime(2000, 1, 1),
        DateTimeKind.Utc);
        }

        archiveFromDate =
            lastArchiveDate
                .ToString("yyyy/MM/dd hh:mm tt");

        archiveToDate =
            DateTime.Now
                .ToString("yyyy/MM/dd hh:mm tt");

        showArchiveDialog = true;
    }

    string Fmt(decimal value)
    {
        if (value % 1 == 0)
            return $"{value:N0} د.ل";

        return $"{value:N2} د.ل";
    }
}