@page "/orders/edit/{id:int}"

@layout Layout.MainLayout
@using SultanCups.Models
@using SultanCups.Services
@inject UserSession Session
@inject FinanceService2 FinanceService
@inject InventoryService InventoryService
@inject SalesService SalesService
@inject ToastService ToastService
@inject NavigationManager Nav

<div class="pro-page">


    <div class="top-bar">
        <button class="btn-back" @onclick='() => Nav.NavigateTo("/orders")'>
            ← رجوع
        </button>

        <div class="money-head">

            <h3 class="money-title-details">
                تعديل فاتورة رقم @Form.order_id
            </h3>

            <img src="images/Money.jpg" />

        </div>

    </div>

    <div class="pro-fields-grid pro-animate">

        <div>
            <label>نوع الشخص</label>
            <select class="pro-input"
                    value="@Form.person_type"
                    disabled>

                <option value="customer">زبون</option>
                <option value="marketer">مسوق</option>

            </select>
        </div>

        @if (Form.person_type == "customer")
        {
            <div>
                <label>الزبون</label>
                <select class="pro-input" @bind="Form.person_id">
                    <option value="0">اختر زبون</option>
                    @foreach (var c in Customers)
                    {
                        <option value="@c.customer_id">@c.name</option>
                    }
                </select>
            </div>
        }

        @if (Form.person_type == "marketer")
        {
            <div>
                <label>المسوق</label>

                <select class="pro-input"
                        value="@Form.person_id"
                        disabled>
                    <option value="0">اختر مسوق</option>
                    @foreach (var m in Marketers)
                    {
                        <option value="@m.marketer_id">@m.name</option>
                    }
                </select>
            </div>

            <div>
                <label>عمولة الصندوق</label>
                <input class="pro-input" @bind="Form.commission_per_box" />
            </div>

            
        }

        <div>
            <label>التاريخ</label>
            <input type="date" class="pro-input" @bind="Form.order_date" />
        </div>

        @if (Form.person_type == "marketer")
{
    <div class="commission-field-wrap">


            <label class="commission-check">

                <span>صرف العمولة الآن</span>

                <input type="checkbox"
                       @bind="Form.pay_commission_now" />

            </label>

        </div>
        }

     

    </div>

    <hr />

    <div class="order-layout1">

        <div class="order-right1">

            <h4>الأصناف</h4>
            <table class="order-table1">
                <thead>
                    <tr class="item-row1 open">
                        <th>المنتج</th>
                        <th>القيمة المرجعية</th>
                        <th>السعر</th>
                        <th>الكمية</th>
                        <th>الإجمالي</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Form.Items)
                    {
                        <tr @key="item"
                            class="item-row1 @(item.IsRemoving ? "" : "open")">

                            <td>
                                <select class="pro-input"
                                        value="@item.product_id"
                                        disabled="@(!item.IsNew)"
                                        @onchange="e => OnProductChanged(e, item)">
                                    <option value="0">اختر</option>

                                    @foreach (var p in Products)
                                    {
                                        <option value="@p.product_id">@p.name</option>
                                    }
                                </select>
                            </td>

                            <td>
                                <input type="number"
                                       step="0.01"
                                       class="pro-input ref-box @(item.production_cost < item.original_reference_value ? "ref-warning" : "")"
                                       @bind-value="item.production_cost"
                                       @bind-value:event="oninput" />
                            </td>

                            <td>
                                <input type="number"
                                       step="0.01"
                                       class="pro-input price-box @(item.unit_price <= item.production_cost ? "ref-warning" : "")"
                                       @bind-value="item.unit_price"
                                       @bind-value:event="oninput" />
                            </td>

                            <td>
                                <input type="number"
                                       class="pro-input qty-box"
                                       @bind-value="item.quantity"
                                       @bind-value:event="oninput" />
                            </td>

                            <td>
                                <input class="pro-input total-box"
                                       value="@(item.quantity * item.unit_price)"
                                       readonly />
                            </td>

                            <td>
                                @if (Form.Items.Count > 1 && item.IsNew)
                                {
                                    <button class="btn-delete-item1"
                                            @onclick="() => RemoveItem(item)">
                                        ✕
                                    </button>
                                }
                            </td>

                        </tr>
                    }
                </tbody>
            </table>

            <button class="pro-btn-add small" @onclick="AddItem">إضافة صنف</button>

            <div class="bottom-actions1">
                <button class="pro-save"
                        @onclick="SaveOrder"
                        disabled="@IsSaving">

                    @if (IsSaving)
                    {
                        <span class="save-loader"></span>
                        <span>جاري التحديث...</span>
                    }
                    else
                    {
                        <span>تحديث الفاتورة</span>
                    }

                </button>
            </div>

        </div>

        <div class="order-left1">

            <div class="summary-box1">

                <div class="pay-btn-wrap">
                    <button class="btn-info fixed-btn" @onclick="OpenPaymentDialog">
                        💳 دفع
                    </button>
                </div>

                <label>الخصم <span class="muted1">(اختياري)</span></label>
                <input type="number"
                       class="pro-input"
                       @bind-value="Form.discount_total"
                       @bind-value:event="oninput" />

                <hr />

                @if (Form.person_type == "marketer")
                {
                    <div class="sum-line1">
                        <span>العمولة</span>
                        <strong class="@(IsCommissionAllowed ? "text-success" : "text-danger")">
                            @Fmt(Commission)
                        </strong>
                    </div>

                    <div class="sum-line1 small">
                        <span>حالة العمولة</span>
                        <strong class="commission-status @(IsCommissionAllowed ? "ok" : "no")">
                            @(IsCommissionAllowed ? " سيتم احتسابها" : " غير محتسبة")
                        </strong>
                    </div>
                }

                @{
                    var remaining = Net - PaymentsTotal;
                    bool isPaid = Net > 0 && remaining <= 0;
                    bool isPartial = PaymentsTotal > 0 && remaining > 0;
                }

                <div class="sum-line1 main">
                    <span>الإجمالي</span>
                    <strong>@Fmt(Net)</strong>
                </div>

                <div class="sum-line1 small">
                    <span>المدفوع</span>
                    <strong class="text-success">@Fmt(PaymentsTotal)</strong>
                </div>

                <div class="sum-line1 small">
                    <span>المتبقي</span>
                    <strong class="@(remaining > 0 ? "text-danger" : "text-success")">
                        @Fmt(remaining)
                    </strong>
                </div>

                <div class="sum-line1 status">
                    <span>الحالة</span>

                    @if (Net == 0)
                    {
                        <div class="status-bar neutral">—</div>
                    }
                    else if (isPaid)
                    {
                        <div class="status-bar paid">✔ تم السداد</div>
                    }
                    else if (isPartial)
                    {
                        <div class="status-bar partial">◐ خالص جزئي</div>
                    }
                    else
                    {
                        <div class="status-bar not-paid">⚠ غير خالص</div>
                    }
                </div>

            </div>

        </div>

    </div>


</div>

@if (ShowPaymentDialog)
{
    <div class="rm-dialog-overlay">
        <div class="rm-dialog-box pay-dialog">

            <div class="pro-dialog-top-image">
                <img src="images/Background.png" />
            </div>

            <div class="rm-dialog-body">

                <div class="money-head">
                    <h3>طرق الدفع</h3>
                    <img src="images/Money.jpg" />
                </div>

                <div class="cashbox-inline">

                    <label class="cash-label">الخزنة</label>

                    <select class="pay-input1 small"
                            @bind="Form.cash_box_id"
                            disabled>

                        <option value="">اختر</option>

                        @foreach (var c in CashBoxes)
                        {
                            <option value="@c.cash_box_id">@c.name</option>
                        }
                    </select>

                </div>

                <div class="payments-box">

                    <div class="payment-header1">
                        <span>النوع</span>
                        <span>المبلغ</span>
                        <span></span>
                    </div>

                    @foreach (var p in TempPayments)
                    {
                        <div class="payment-row1">

                            <select class="pay-input1" value="@p.method"
                                    @onchange="e => OnPaymentMethodChanged(e, p)">

                                @foreach (var m in new[] { "cash", "card", "transfer", "check" })
                                {
                                    var used = TempPayments.Any(x => x.method == m && x != p);

                                    if (!used || m == p.method)
                                    {
                                        <option value="@m">@GetMethodName(m)</option>
                                    }
                                }

                            </select>

                            <input class="pay-input1" value="@p.amount" readonly />
                            <button class="pay-add1"
                                    @onclick="() => OpenAddDialog(p.method)">
                                إضافة دفعة
                            </button>

                            <button class="pay-delete1"
                                    @onclick="() => OpenRefundDialog(p.method)">
                                استرجاع
                            </button>

                        </div>
                    }

                    <button class="rm-add-btn small" @onclick="AddTempPayment">
                        إضافة دفعة من نوع آخر
                    </button>

                </div>

                <div class="pay-actions1">
                    <button class="pay-save1" @onclick="ClosePaymentDialog">تم</button>
                    <button class="pay-cancel1" @onclick="CancelPaymentDialog">إلغاء</button>
                </div>

            </div>

        </div>
    </div>
}

@if (ShowAddDialog)
{
    <div class="pro-dialog-overlay">
        <div class="pro-dialog-box small-dialog">

            <div class="pro-dialog-top-image">
                <img src="images/Background.png" />
            </div>

            <div class="pro-dialog-body">

                <div class="money-head">
                    <img src="images/Money.jpg" />
                    <h3>إضافة دفعة</h3>
                </div>

                <input type="number" class="pro-input" @bind="AddAmount" />

                <div class="pay-modal-actions-row">
                    <button class="pro-save" @onclick="ConfirmAdd">حفظ</button>
                    <button class="pro-save pro-cancel" @onclick="() => ShowAddDialog = false">إلغاء</button>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowRefundDialog)
{
    <div class="pro-dialog-overlay">
        <div class="pro-dialog-box small-dialog">

            <div class="pro-dialog-top-image">
                <img src="images/Background.png" />
            </div>

            <div class="pro-dialog-body">

                <div class="money-head">
                    <img src="images/Money.jpg" />
                    <h3>استرجاع مبلغ</h3>
                </div>

                <input type="number" class="pro-input" @bind="RefundAmount" />

                <div class="pay-modal-actions-row">
                    <button class="pro-save" @onclick="ConfirmRefund">تأكيد</button>
                    <button class="pro-save pro-cancel" @onclick="() => ShowRefundDialog = false">إلغاء</button>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowChangesDialog)
{
    <div class="pro-dialog-overlay">

        <div class="pro-dialog-box small-dialog">

            <div class="pro-dialog-top-image">
                <img src="images/Background.png" />
            </div>

            <div class="pro-dialog-body">

                <div class="money-head">
                    <h3>التغييرات المالية</h3>
                    <img src="images/Money.jpg" />
                </div>

                <div class="cancel-preview">

                    <div class="cancel-section">

                        @foreach (var msg in ChangeMessages)
                        {
                            <div class="cancel-item">
                                <span>@msg</span>
                            </div>
                        }

                    </div>

                </div>

                <div class="pay-modal-actions-row">

                    <button class="pro-save"
                            @onclick="ConfirmUpdate">
                        متابعة
                    </button>

                    <button class="pro-cancel"
                            @onclick="() => ShowChangesDialog = false">
                        إلغاء
                    </button>

                </div>

            </div>

        </div>

    </div>
}

@if (ShowErrorDialog)
{
    <div class="return-dialog-overlay">

        <div class="return-dialog-box">

            <div class="return-dialog-top-image">

                <img src="images/Background.png" />

            </div>

            <div class="return-dialog-body">

                <div class="return-help-head">

                    <img src="images/Buttons.png"
                         class="return-help-img" />

                </div>

                <div class="return-help-preview">

                    <div class="return-help-item">

                        <span>

                            @ErrorDialogMessage

                        </span>

                    </div>

                </div>

                <div class="return-dialog-actions">

                    <button class="return-dialog-btn"
                            @onclick="() => ShowErrorDialog = false">

                        فهمت

                    </button>

                </div>

            </div>

        </div>

    </div>
}


@code {


[Parameter] public int id { get; set; }

    List<Product> Products = new();
    List<Customer> Customers = new();
    List<Marketer> Marketers = new();
    List<CashBox> CashBoxes = new();

    Order Form = new();

    List<PaymentInput> Payments = new();
    List<PaymentInput> TempPayments = new();

    bool ShowPaymentDialog;

    bool ShowErrorDialog = false;

    string ErrorDialogMessage = "";

    int CurrentAdminId => Session.AdminId;

    bool ShowAddDialog = false;
    bool ShowRefundDialog = false;

    string CurrentMethod = "";

    bool IsSaving = false;

    decimal AddAmount;
    decimal RefundAmount;
    HashSet<int> OldProductIds = new();

    bool ShowChangesDialog = false;

    List<string> ChangeMessages = new();

    List<PaymentInput> OriginalPayments = new();

    decimal OriginalNet = 0;

    decimal OriginalCommission = 0;

    bool OriginalPayCommissionNow = false;

    protected override async Task OnInitializedAsync()
    {
        Products = await InventoryService.GetProducts();
        Customers = await SalesService.GetActiveCustomers();
        Marketers = await SalesService.GetActiveMarketers();
        CashBoxes = await FinanceService.GetCashBoxes();

        await LoadOrder();
    }

    async Task LoadOrder()
    {
        var order = await FinanceService.GetOrderById(id);
        var payments = await FinanceService.GetPaymentsByOrder(id);

        if (order == null)
        {
            Nav.NavigateTo("/orders");
            return;
        }

        Form = new Order
        {
            order_id = order.order_id,
            person_id = order.person_id,
            person_type = order.person_type,
            discount_total = order.discount_total,
            cash_box_id = order.cash_box_id,
            notes = order.notes,
            commission_per_box = order.commission_per_box,
            pay_commission_now = order.pay_commission_now,
            order_date = order.order_date,

            Items = order.Items
.Select(i => new OrderItem
{
    product_id = i.product_id,
    product_name = i.product_name,

    quantity = i.quantity,
    unit_price = i.unit_price,

    production_cost = i.production_cost,
    original_reference_value = i.production_cost,

    IsNew = false
}).ToList()
        };

        OldProductIds = Form.Items
            .Select(x => x.product_id)
            .ToHashSet();

        Payments = payments
            .GroupBy(p => p.payment_method)
            .Select(g => new PaymentInput
            {
                method = g.Key!,
                amount = g.Sum(x =>
                    x.direction == "IN"
                        ? x.amount
                        : -x.amount)
            })
            .ToList();

        // ====================================
        // 🔥 حفظ القيم الأصلية للمقارنة
        // ====================================

        OriginalPayments = Payments
            .Select(x => new PaymentInput
            {
                method = x.method,
                amount = x.amount
            })
            .ToList();

        OriginalNet = Net;

        OriginalCommission = Commission;

        OriginalPayCommissionNow =
            Form.pay_commission_now;
    }

    void OnPaymentMethodChanged(ChangeEventArgs e, PaymentInput current)
    {
        var newMethod = e.Value?.ToString();

        var exists = TempPayments
            .Any(p => p.method == newMethod && p != current);

        if (exists)
        {
            ToastService.ShowToast("لا يمكن تكرار نفس نوع الدفع", "error");
            return;
        }

        current.method = newMethod!;
    }

    void OpenPaymentDialog()
    {
        TempPayments = Payments
     .Select(p => new PaymentInput
     {
         method = p.method,
         amount = p.amount
     }).ToList();

        if (!TempPayments.Any())
        {
            TempPayments.Add(new PaymentInput
            {
                method = "cash",
                amount = 0
            });
        }

        ShowPaymentDialog = true;
    }

    string GetMethodName(string m) => m switch
    {
        "cash" => "كاش",
        "card" => "بطاقة",
        "transfer" => "تحويل",
        "check" => "شيك",
        _ => m
    };

    void OpenAddDialog(string method)
    {
        // 🔥 اقفل الباقي
        ShowRefundDialog = false;

        CurrentMethod = method;
        AddAmount = 0;
        ShowAddDialog = true;
    }

    void OpenRefundDialog(string method)
    {
        // 🔥 اقفل الباقي
        ShowAddDialog = false;

        CurrentMethod = method;
        RefundAmount = 0;
        ShowRefundDialog = true;
    }

    async Task ConfirmUpdate()
    {
        ShowChangesDialog = false;

        IsSaving = true;

        var result = await FinanceService.UpdateOrder(
            Form,
            Form.Items,
            Payments,
            CurrentAdminId
        );

        IsSaving = false;

        if (result.success)
        {

            OriginalPayments = Payments
    .Select(x => new PaymentInput
    {
        method = x.method,
        amount = x.amount
    })
    .ToList();

            OriginalNet = Net;

            OriginalCommission = Commission;

            OriginalPayCommissionNow =
                Form.pay_commission_now;

            ToastService.ShowToast("تم التعديل", "success");
            Nav.NavigateTo("/orders");
        }
        else
        {
            IsSaving = false;



            if (result.message.Contains("لا يمكن إنقاص الكمية"))
            {
                ErrorDialogMessage = result.message;
                ShowErrorDialog = true;
                return;
            }

            ToastService.ShowToast(result.message, "error");
        }
    }

    void ConfirmAdd()
    {
        if (AddAmount <= 0)
        {
            ToastService.ShowToast("أدخل مبلغ صحيح", "error");
            return;
        }

        var totalAfter = TempPayments.Sum(x => x.amount) + AddAmount;

        if (totalAfter > Net)
        {
            ToastService.ShowToast("المبلغ يتجاوز المتبقي", "error");
            return;
        }

        var item = TempPayments.FirstOrDefault(x => x.method == CurrentMethod);

        if (item != null)
            item.amount += AddAmount;

        ShowAddDialog = false;
    }

    void ConfirmRefund()
    {
        if (RefundAmount <= 0)
        {
            ToastService.ShowToast("أدخل مبلغ صحيح", "error");
            return;
        }

        var item = TempPayments.FirstOrDefault(x => x.method == CurrentMethod);

        if (item == null) return;

        if (RefundAmount > item.amount)
        {
            ToastService.ShowToast("المبلغ أكبر من المدفوع", "error");
            return;
        }

        item.amount -= RefundAmount;

        ShowRefundDialog = false;
    }

    void AddTempPayment()
    {
        if (TempPayments.Count >= 4) return;

        var methods = TempPayments.Select(x => x.method).ToList();
        var all = new[] { "cash", "card", "transfer", "check" };

        var next = all.FirstOrDefault(m => !methods.Contains(m));

        if (next == null)
        {
            ToastService.ShowToast("لا يمكن تكرار نفس نوع الدفع، استخدم إضافة دفعة", "error");
            return;
        }

        TempPayments.Add(new PaymentInput
        {
            method = next,
            amount = 0
        });
    }



    void ClosePaymentDialog()
    {
        if (TempPayments.Any(p => p.amount < 0))
        {
            ToastService.ShowToast("لا يمكن إدخال مبلغ سالب", "error");
            return;
        }

        var total = TempPayments.Sum(p => p.amount);

        if (total > Net)
        {
            ToastService.ShowToast("المبلغ أكبر من الإجمالي", "error");
            return;
        }

        bool hasFinancialImpact =
            TempPayments.Sum(p => p.amount) > 0 ||
            Form.pay_commission_now;

        if (hasFinancialImpact &&
            Form.cash_box_id <= 0)
        {
            ToastService.ShowToast("اختر الخزنة أولاً", "error");
            return;
        }

        Payments = TempPayments
            .Select(p => new PaymentInput
            {
                method = p.method,
                amount = p.amount
            }).ToList();

        ShowPaymentDialog = false;
    }

    void CancelPaymentDialog()
    {
        ShowPaymentDialog = false;
    }

    async Task SaveOrder()
    {
        try
        {
            if (IsSaving)
                return;

            IsSaving = true;

            Form.order_date = DateTime.SpecifyKind(Form.order_date, DateTimeKind.Utc);

            if (Form.person_id == 0)
            {
                ToastService.ShowToast("اختر الشخص", "error");
                return;
            }

            if (!Form.Items.Any())
            {
                ToastService.ShowToast("أضف صنف واحد على الأقل", "error");
                return;
            }

            if (Form.Items.Any(i => i.product_id == 0))
            {
                ToastService.ShowToast("اختر المنتج", "error");
                return;
            }

            if (Form.Items.Any(i => i.quantity <= 0))
            {
                ToastService.ShowToast("الكمية غير صحيحة", "error");
                return;
            }

            var net = Form.Items.Sum(i => i.quantity * i.unit_price) - Form.discount_total;

            if (Payments.Sum(p => p.amount) > net)
            {
                ToastService.ShowToast("المبلغ المدفوع أكبر من الإجمالي", "error");
                return;
            }

            if (Payments.Any(p => p.amount < 0))
            {
                ToastService.ShowToast("لا يمكن إدخال مبلغ سالب", "error");
                return;
            }

            var oldPaid = (await FinanceService.GetPaymentsByOrder(id))
    .Sum(x => x.direction == "IN" ? x.amount : -x.amount);

            var newPaid = Payments.Sum(p => p.amount);

            bool hasFinancialImpact =
    newPaid > 0 ||
    Form.pay_commission_now;

            // 🔥 لا يوجد تأثير مالي
            // اسمح بخزنة افتراضية
            if (!hasFinancialImpact &&
                Form.cash_box_id <= 0)
            {
                var firstCashBox = CashBoxes.FirstOrDefault();

                if (firstCashBox != null)
                    Form.cash_box_id = firstCashBox.cash_box_id;
            }

            // 🔥 يوجد تأثير مالي
            // يجب اختيار خزنة حقيقية
            if (hasFinancialImpact &&
                Form.cash_box_id <= 0)
            {
                ToastService.ShowToast(
                    "اختر الخزنة أولاً",
                    "error"
                );

                return;
            }

            ChangeMessages.Clear();

            // ====================================
            // فرق الإجمالي
            // ====================================

            var netDiff = Net - OriginalNet;

            if (netDiff > 0)
            {
                ChangeMessages.Add(
                    $"زيادة على الفاتورة: +{netDiff:0.00} د.ل");
            }
            else if (netDiff < 0)
            {
                ChangeMessages.Add(
                    $"نقص من الفاتورة: {Math.Abs(netDiff):0.00} د.ل");
            }

            // ====================================
            // فرق العمولة
            // ====================================

            var commissionDiff = Commission - OriginalCommission;

            if (!OriginalPayCommissionNow &&
                Form.pay_commission_now)
            {
                ChangeMessages.Add(
                    $"سيتم تسجيل عمولة للمسوق: {Commission:0.00} د.ل");
            }
            else if (OriginalPayCommissionNow &&
                     !Form.pay_commission_now)
            {
                ChangeMessages.Add(
                    $"سيتم استرجاع عمولة: {OriginalCommission:0.00} د.ل");
            }
            else if (Form.pay_commission_now)
            {
                if (commissionDiff > 0)
                {
                    ChangeMessages.Add(
                        $"زيادة مستحقة للمسوق: +{commissionDiff:0.00} د.ل");
                }
                else if (commissionDiff < 0)
                {
                    ChangeMessages.Add(
                        $"سيتم خصم فرق عمولة: {Math.Abs(commissionDiff):0.00} د.ل");
                }
            }

            // ====================================
            // فرق الدفعات
            // ====================================

            var paidDiff = newPaid - oldPaid;


            if (paidDiff > 0)
            {
                ChangeMessages.Add(
                    $"زيادة دفعات: +{paidDiff:0.00} د.ل");
            }
            else if (paidDiff < 0)
            {
                ChangeMessages.Add(
                    $"استرجاع دفعات: {Math.Abs(paidDiff):0.00} د.ل");
            }

            // ====================================
            // إظهار الحوار
            // ====================================

            if (ChangeMessages.Any())
            {
                ShowChangesDialog = true;
                IsSaving = false;
                return;
            }

            // 🔥 بعدها مباشرة
            var result = await FinanceService.UpdateOrder(
                Form,
                Form.Items,
                Payments,
                CurrentAdminId
            );

            if (result.success)
            {
                ToastService.ShowToast("تم التعديل ", "success");
                Nav.NavigateTo("/orders");
            }
            else
            {
                IsSaving = false;


                if (result.message.Contains("لا يمكن إنقاص الكمية"))
                {
                    ErrorDialogMessage = result.message;
                    ShowErrorDialog = true;
                    return;
                }

                ToastService.ShowToast(result.message, "error");
            }
        }
        catch (Exception)
        {
            ToastService.ShowToast(
                "تعذر إكمال العملية بسبب خطأ داخلي، يرجى التواصل مع مطور النظام",
                "error"
            );
        }

        finally
        {
            IsSaving = false;
        }
    }

    async Task RemoveItem(OrderItem item)
    {
        item.IsRemoving = true;

        await Task.Delay(200);

        Form.Items.Remove(item);
    }

    async Task AddItem()
    {
        var item = new OrderItem
        {
            product_id = 0,
            quantity = 1,
            unit_price = 0,
            IsRemoving = true,
            IsNew = true
        };

        Form.Items.Add(item);

        await Task.Delay(10);

        item.IsRemoving = false;
    }

    bool IsCommissionAllowed => Form.pay_commission_now;

    decimal Commission
    {
        get
        {
            if (Form.person_type != "marketer")
                return 0;

            var qty = Form.Items.Sum(i => i.quantity);
            return qty * Form.commission_per_box;
        }
    }

    async Task OnProductChanged(ChangeEventArgs e, OrderItem item)
    {
        int id = int.Parse(e.Value?.ToString() ?? "0");

        var existing = Form.Items
            .FirstOrDefault(i =>
                i.product_id == id &&
                i != item &&
                i.product_id != 0
            );

        if (existing != null)
        {
            Form.Items.Remove(item);

            ToastService.ShowToast(
                "هذا المنتج مضاف مسبقًا، عدّل الكمية بدلًا من إضافة صف جديد",
                "error"
            );

            return;
        }

        item.product_id = id;

        var product = Products.FirstOrDefault(p => p.product_id == id);

        if (product != null)
        {
            item.unit_price = product.sale_price;

            var lastCost = await FinanceService.GetLastProductionCost(id);

            item.production_cost = lastCost;
            item.original_reference_value = lastCost;
        }
    }

    decimal Total => Form.Items.Sum(i => i.quantity * i.unit_price);
    decimal Net => Math.Max(0, Total - Form.discount_total);    
    decimal PaymentsTotal => Payments.Sum(x => x.amount);

    string Fmt(decimal v) => $"{v:0.00} د.ل";



}
