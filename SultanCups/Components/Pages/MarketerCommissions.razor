@page "/marketerCommissions"
@layout Layout.MainLayout
@using SultanCups.Models
@using SultanCups.Services

@using System.Globalization
@inject FinanceService2 FinanceService
@inject NavigationManager Nav

<div class="pro-page">

    <div class="pro-topbar">
        <div></div>
        <h2 class="pro-title">عمولات المسوقين</h2>
        <div></div>
    </div>

    <div class="pro-search-bar">

        <input class="mk-search-input"
               placeholder="بحث باسم المسوق أو رقم الفاتورة"
               @bind="SearchText"
               @bind:event="oninput" />

        <select class="pro-filter-select" @bind="StatusFilter">
            <option value="all">كل الحالات</option>
            <option value="ready">تم الصرف</option>
            <option value="pending">معلقة</option>
        </select>

        <input type="date"
               class="pro-filter-select"
               @bind="DayFilter" />

        <select class="pro-filter-select" @bind="MonthFilter">
            <option value="0">كل الشهور</option>

            @for (int i = 1; i <= 12; i++)
            {
                <option value="@i">@CultureInfo.GetCultureInfo("ar").DateTimeFormat.GetMonthName(i)</option>
            }
        </select>

    </div>

    <div class="pro-card">

        <div class="pro-table-wrap">

            <table class="pro-table">

                <thead>
                    <tr>
                        <th>رقم الفاتورة</th>
                        <th>اسم المسوق</th>
                        <th>إجمالي الفاتورة</th>
                        <th>العمولة</th>
                        <th>الإجمالي بعد العمولة</th>
                        <th>الحالة</th>
                        <th>التاريخ</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>

                <tbody>

                    @if (CommissionList == null)
                    {
                        <tr>
                            <td colspan="7">جاري التحميل...</td>
                        </tr>
                    }

                    else if (!FilteredList.Any())
                    {
                        <tr>
                            <td colspan="7" class="st-empty-text">

                                <div class="empty-state">
                                    <img src="images/Empty.jpg" class="empty-img" />
                                    <span>لا توجد عمولات</span>
                                </div>

                            </td>
                        </tr>
                    }

                    else
                    {
                        @foreach (var c in FilteredList)
                        {
                            <tr>

                                <td class="pro-code">
                                    @c.order_id
                                </td>

                                <td>
                                    @c.marketer_name
                                </td>

                                <td>
                                    @Fmt(c.order_total)
                                </td>

                                <td>
                                    <span class="commission-orange">
                                        @Fmt(c.commission_total)
                                    </span>
                                </td>

                                <td>
                                    @Fmt(c.order_total + c.commission_total)
                                </td>

                                <td>

                                    @if (c.commission_status == "محتسبة")
                                    {
                                        <span class="st-badge st-badge-success">
                                            تم الصرف ✔
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="st-badge st-badge-warning">
                                            معلقة ⏳
                                        </span>
                                    }

                                </td>

                                <td>
                                    @c.order_date.ToString("yyyy-MM-dd")
                                </td>

                                <td>
                                    <button class="debt-go-order-btn"
                                            @onclick='() => Nav.NavigateTo($"/orders?new={c.order_id}")'>

                                        الانتقال إلى الفاتورة

                                    </button>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@code {

    List<MarketerCommissionView>? CommissionList;

    string SearchText = "";

    string StatusFilter = "all";

    DateTime? DayFilter = null;

    int MonthFilter = 0;

    protected override async Task OnInitializedAsync()
    {
        CommissionList = await FinanceService.GetMarketerCommissions();
    }

    IEnumerable<MarketerCommissionView> FilteredList =>
        (CommissionList ?? Enumerable.Empty<MarketerCommissionView>())

        .Where(x =>

            (string.IsNullOrWhiteSpace(SearchText)
            || x.marketer_name.Contains(SearchText, StringComparison.OrdinalIgnoreCase)
            || x.order_id.ToString().Contains(SearchText))

            &&

            (
    StatusFilter == "all"

    ||

    (StatusFilter == "ready"
        && x.commission_status == "محتسبة")

    ||

    (StatusFilter == "pending"
        && x.commission_status == "غير محتسبة")
)

            &&

(DayFilter == null
|| x.order_date.Date == DayFilter.Value.Date)

&&

(
    MonthFilter == 0
    ||
    x.order_date.Month == MonthFilter
)

        );


    string Fmt(decimal v) => $"{v:0.00} د.ل";

}