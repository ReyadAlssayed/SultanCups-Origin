@page "/marketerCommissions"
@layout Layout.MainLayout
@using SultanCups.Models
@using SultanCups.Services

@using ClosedXML.Excel
@inject IJSRuntime JS
@using System.Globalization
@inject FinanceService2 FinanceService
@inject StatsAndArchiveService StatsService
@inject NavigationManager Nav

<div class="pro-page">

    <div class="pro-topbar">

        <h2 class="pro-title">عمولات المسوقين</h2>

        <button class="pro-btn-excel"
                @onclick="ExportToExcel"
                disabled="@IsExporting">
            أرشفة Excel
        </button>

     

        <div></div>

    </div>

    <div class="pro-search-bar">

        <input class="mk-search-input"
               placeholder="بحث باسم المسوق أو رقم الفاتورة"
               @bind="SearchText"
               @bind:event="oninput" />

        <select class="pro-filter-select" @bind="StatusFilter">
            <option value="all">كل الحالات</option>
            <option value="ready">تم الصرف</option>
            <option value="pending">معلقة</option>
        </select>

        <input type="date"
               class="pro-filter-select"
               @bind="DayFilter" />

        <select class="pro-filter-select" @bind="MonthFilter">
            <option value="0">كل الشهور</option>

            @for (int i = 1; i <= 12; i++)
            {
                <option value="@i">@CultureInfo.GetCultureInfo("ar").DateTimeFormat.GetMonthName(i)</option>
            }
        </select>

    </div>

    <div class="pro-card">

        <div class="pro-table-wrap">

            <table class="pro-table">

                <thead>
                    <tr>
                        <th>رقم الفاتورة</th>
                        <th>اسم المسوق</th>
                        <th>إجمالي الفاتورة</th>
                        <th>العمولة</th>
                        <th>الإجمالي بعد العمولة</th>
                        <th>الحالة</th>
                        <th>التاريخ</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>

                <tbody>

                    @if (CommissionList == null)
                    {
                        <tr>
                            <td colspan="7">جاري التحميل...</td>
                        </tr>
                    }

                    else if (!FilteredList.Any())
                    {
                        <tr>
                            <td colspan="7" class="st-empty-text">

                                <div class="empty-state">
                                    <img src="images/Empty.jpg" class="empty-img" />
                                    <span>لا توجد عمولات</span>
                                </div>

                            </td>
                        </tr>
                    }

                    else
                    {
                        @foreach (var c in FilteredList)
                        {
                           
    bool isOld =
        c.order_date < lastArchiveDate;


<tr class="@(isOld ? "old-archive-row" : "")">

                                <td class="pro-code">
                                    @c.order_id
                                </td>

                                <td>
                                    @c.marketer_name
                                </td>

                                <td>
                                    @Fmt(c.order_total)
                                </td>

                                <td>
                                    <span class="commission-orange">
                                        @Fmt(c.commission_total)
                                    </span>
                                </td>

                                <td>
                                    @Fmt(c.order_total + c.commission_total)
                                </td>

                                <td>

                                    @if (c.commission_status == "محتسبة")
                                    {
                                        <span class="commission-status-paid">
                                            تم الصرف
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="commission-status-pending">
                                            معلقة⏳
                                        </span>
                                    }

                                </td>

                                <td>
                                    @c.order_date.ToString("yyyy-MM-dd")
                                </td>

                                <td>
                                    <button class="debt-go-order-btn"
                                            @onclick='() => Nav.NavigateTo($"/orders?new={c.order_id}")'>

                                        الانتقال إلى الفاتورة

                                    </button>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@if (IsExporting)
{
    <div class="excel-loading-overlay">
        <div class="excel-loading-box">
            جاري الأرشفة...
        </div>
    </div>
}

@code {

    List<MarketerCommissionView>? CommissionList;

    DateTime lastArchiveDate;

    string SearchText = "";

    string StatusFilter = "all";

    DateTime? DayFilter = null;

    bool IsExporting = false;

    int MonthFilter = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            CommissionList = await FinanceService.GetMarketerCommissions();
            lastArchiveDate =
    await StatsService.GetLastArchiveDate();
        }
        catch
        {
            CommissionList = new();
        }
    }

    async Task ExportToExcel()
    {
        if (IsExporting)
            return;

        IsExporting = true;

        await InvokeAsync(StateHasChanged);

        await Task.Delay(300);

        try
        {
            using var workbook = new XLWorkbook();

            var ws =
                workbook.Worksheets.Add("العمولات");

            ws.Cell(1, 1).Value = "رقم الفاتورة";
            ws.Cell(1, 2).Value = "اسم المسوق";
            ws.Cell(1, 3).Value = "إجمالي الفاتورة";
            ws.Cell(1, 4).Value = "العمولة";
            ws.Cell(1, 5).Value = "الإجمالي بعد العمولة";
            ws.Cell(1, 6).Value = "الحالة";
            ws.Cell(1, 7).Value = "التاريخ";

            int row = 2;

            foreach (var c in FilteredList)
            {
                ws.Cell(row, 1).Value = c.order_id;
                ws.Cell(row, 2).Value = c.marketer_name;
                ws.Cell(row, 3).Value = c.order_total;
                ws.Cell(row, 4).Value = c.commission_total;
                ws.Cell(row, 5).Value =
                    c.order_total + c.commission_total;

                ws.Cell(row, 6).Value =
                    c.commission_status == "محتسبة"
                        ? "تم الصرف"
                        : "معلقة";

                ws.Cell(row, 7).Value =
                    c.order_date.ToString("yyyy-MM-dd");

                bool isOld =
                    c.order_date < lastArchiveDate;

                if (isOld)
                {
                    ws.Range(row, 1, row, 7)
                        .Style.Fill.BackgroundColor =
                            XLColor.FromHtml("#fff7ed");
                }

                row++;
            }

            ws.Row(1).Style.Font.Bold = true;

            ws.Row(1).Style.Fill.BackgroundColor =
                XLColor.LightGreen;

            ws.Columns().AdjustToContents();

            ws.RightToLeft = true;

            using var stream = new MemoryStream();

            workbook.SaveAs(stream);

            await JS.InvokeVoidAsync(
                "downloadFile",
                $"Commissions_{DateTime.Now:yyyyMMddHHmmss}.xlsx",
                Convert.ToBase64String(stream.ToArray())
            );
        }
        finally
        {
            IsExporting = false;

            await InvokeAsync(StateHasChanged);
        }
    }

    IEnumerable<MarketerCommissionView> FilteredList =>
        (CommissionList ?? Enumerable.Empty<MarketerCommissionView>())

        .Where(x =>

            (string.IsNullOrWhiteSpace(SearchText)
            || x.marketer_name.Contains(SearchText, StringComparison.OrdinalIgnoreCase)
            || x.order_id.ToString().Contains(SearchText))

            &&

            (
    StatusFilter == "all"

    ||

    (StatusFilter == "ready"
        && x.commission_status == "محتسبة")

    ||

    (StatusFilter == "pending"
        && x.commission_status == "غير محتسبة")
)

            &&

(DayFilter == null
|| x.order_date.Date == DayFilter.Value.Date)

&&

(
    MonthFilter == 0
    ||
    x.order_date.Month == MonthFilter
)

        );


    string Fmt(decimal v) => $"{v:0.00} د.ل";

}