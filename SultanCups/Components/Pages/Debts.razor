@page "/Debts"
@layout Layout.MainLayout
@using SultanCups.Models
@using SultanCups.Services
@inject FinanceService2 FinanceService

@inject StatsAndArchiveService StatsService
@inject NavigationManager Nav
@using ClosedXML.Excel
@inject IJSRuntime JS

<div class="pro-page">

    <div class="pro-topbar">

       

        <h2 class="pro-title">سجل الديون</h2>

        <button class="pro-btn-excel"
                @onclick="ExportToExcel"
                disabled="@IsExporting">
            أرشفة Excel
        </button>

        <div></div>

    </div>

    <!-- 🔍 البحث والفلاتر -->
    <div class="pro-search-bar">

        <input class="mk-search-input"
               placeholder="بحث باسم الشخص (زبون أو مسوق) أو رقم الفاتورة"
               @bind="NameSearch"
               @bind:event="oninput" />

        <select class="pro-filter-select" @bind="PersonFilter">
            <option value="all">الكل</option>
            <option value="customer">زبائن</option>
            <option value="marketer">مسوقين</option>
        </select>

        <select class="pro-filter-select" @bind="StatusFilter">
            <option value="all">كل الحالات</option>
            <option value="full">دين كامل</option>
            <option value="partial">خالص جزئي</option>
        </select>

        <input type="date"
               class="pro-filter-select"
               @bind="DayFilter" />

    </div>

    <div class="pro-card">

        <div class="pro-table-wrap">

            <table class="pro-table">
                <thead>
                    <tr>
                        <th>رقم الفاتورة</th>
                        <th>الاسم</th>
                        <th>الإجمالي</th>
                        <th>المدفوع</th>
                        <th>المتبقي</th>
                        <th>الحالة</th>
                        <th>التاريخ</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>

                <tbody>
                    @if (DebtList == null)
                    
                    {
                        <tr>
                            <td colspan="8">جاري التحميل...</td>
                        </tr>
                    }
                    else if (!FilteredList.Any())
                    {
                        <tr>
                            <td colspan="8" class="st-empty-text">
                                <div class="empty-state">
                                    <img src="images/Empty.jpg" class="empty-img" />
                                    <span>لا توجد ديون</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var d in FilteredList)
                        {

                            bool isOld =
    d.order_date < lastArchiveDate;
                            <tr class="@(isOld ? "old-archive-row" : "")">
                                <td class="pro-code">@d.order_id</td>
                                <td>@d.person_name</td>

                                <td>
                                    <span class="pro-total">@Fmt(d.net_total)</span>
                                </td>

                                <td>@Fmt(d.paid_amount)</td>

                                <td>
                                    <span class="pro-total" style="color:#dc2626;">
                                        @Fmt(d.remaining)
                                    </span>
                                </td>

                                <td>
                                    <span class="@(d.status == "دين كامل" ? "st-badge st-badge-danger" : "st-badge st-badge-warning")">
                                        @d.status
                                    </span>
                                </td>

                                <td>@d.order_date.ToString("yyyy-MM-dd")</td>

                                <td>

                                    <button class="debt-go-order-btn"
                                            @onclick='() => Nav.NavigateTo($"/orders?new={d.order_id}")'>

                                        الانتقال إلى الفاتورة

                                    </button>

                                </td>
                            </tr>
                        }
                    }

                </tbody>
            </table>

        </div>
    </div>

</div>


@code {

List<DebtView>? DebtList;

    string NameSearch = "";
    string PersonFilter = "all";
    string StatusFilter = "all";

    DateTime lastArchiveDate;
    bool IsExporting = false;

    DateTime? DayFilter = null;


    protected override async Task OnInitializedAsync()
    {
        DebtList = await FinanceService.GetDebts();
        lastArchiveDate =
    await StatsService.GetLastArchiveDate();
    }

    async Task ExportToExcel()
    {
        if (IsExporting)
            return;

        IsExporting = true;

        await InvokeAsync(StateHasChanged);

        await Task.Delay(300);

        try
        {
            using var workbook = new XLWorkbook();

            var ws = workbook.Worksheets.Add("الديون");

            ws.Cell(1, 1).Value = "رقم الفاتورة";
            ws.Cell(1, 2).Value = "الاسم";
            ws.Cell(1, 3).Value = "الإجمالي";
            ws.Cell(1, 4).Value = "المدفوع";
            ws.Cell(1, 5).Value = "المتبقي";
            ws.Cell(1, 6).Value = "الحالة";
            ws.Cell(1, 7).Value = "التاريخ";

            int row = 2;

            foreach (var d in FilteredList)
            {
                ws.Cell(row, 1).Value = d.order_id;
                ws.Cell(row, 2).Value = d.person_name;
                ws.Cell(row, 3).Value = d.net_total;
                ws.Cell(row, 4).Value = d.paid_amount;
                ws.Cell(row, 5).Value = d.remaining;
                ws.Cell(row, 6).Value = d.status;
                ws.Cell(row, 7).Value =
                    d.order_date.ToString("yyyy-MM-dd");

                bool isOld =
                    d.order_date < lastArchiveDate;

                if (isOld)
                {
                    ws.Range(row, 1, row, 7)
                        .Style.Fill.BackgroundColor =
                            XLColor.FromHtml("#fff7ed");
                }

                row++;
            }

            ws.Row(1).Style.Font.Bold = true;

            ws.Row(1).Style.Fill.BackgroundColor =
                XLColor.LightGreen;

            ws.Columns().AdjustToContents();

            ws.RightToLeft = true;

            using var stream = new MemoryStream();

            workbook.SaveAs(stream);

            await JS.InvokeVoidAsync(
                "downloadFile",
                $"Debts_{DateTime.Now:yyyyMMddHHmmss}.xlsx",
                Convert.ToBase64String(stream.ToArray())
            );
        }
        finally
        {
            IsExporting = false;

            await InvokeAsync(StateHasChanged);
        }
    }


    IEnumerable<DebtView> FilteredList =>
     (DebtList ?? Enumerable.Empty<DebtView>())
     .Where(d =>
         (string.IsNullOrWhiteSpace(NameSearch) ||
          d.person_name.Contains(NameSearch, StringComparison.OrdinalIgnoreCase) ||
          d.order_id.ToString().Contains(NameSearch))

         && (PersonFilter == "all" ||
             (PersonFilter == "customer" && d.person_type == "customer") ||
             (PersonFilter == "marketer" && d.person_type == "marketer"))

         && (StatusFilter == "all" ||
             (StatusFilter == "full" && d.status == "دين كامل") ||
             (StatusFilter == "partial" && d.status == "خالص جزئي"))

         && (DayFilter == null || d.order_date.Date == DayFilter.Value.Date)
     );

    string Fmt(decimal v) => $"{v:0.00} د.ل";


}
