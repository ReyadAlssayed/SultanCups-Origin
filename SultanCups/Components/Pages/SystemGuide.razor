@page "/SystemGuide"
@layout MainLayout

<div class="guide-page">

    <div class="guide-header">

        <img src="images/Direction.png"
             class="guide-image"
             alt="System Guide" />

        <div class="guide-overlay"></div>

        <div class="guide-header-content">
            <h1>دليل نظام السلطان</h1>

            <p>
                تم إعداد هذا الدليل لتوضيح آلية عمل النظام بصورة صحيحة وآمنة،
                وضمان المحافظة على دقة البيانات المالية والمخزنية والإدارية داخل المصنع.
            </p>
        </div>

    </div>

    <div class="guide-sections">

        <!-- التعليمات العامة -->

        <div class="guide-category">
            <h2>📘 التعليمات العامة</h2>

            <div class="guide-card">
                يعتمد النظام على التسجيل الحقيقي والدقيق لجميع العمليات المالية والمخزنية والإدارية،
                وأي عملية غير مسجلة قد تؤثر على دقة الإحصائيات والمتابعة المالية.
            </div>

            <div class="guide-card">
                جميع العمليات المالية داخل النظام تعتمد على الدينار الليبي فقط،
                سواء في المبيعات أو المشتريات أو المصاريف أو غيرها من الحركات المالية.
            </div>

            <div class="guide-card">
                النظام مصمم ليكون أداة متابعة ومراقبة مالية وإدارية دقيقة،
                ويساعد في دعم القرار المحاسبي والإداري بصورة احترافية.
            </div>
        </div>

        <!-- الإحصائيات -->

        <div class="guide-category">
            <h2>📊 الإحصائيات والتقارير</h2>

            <div class="guide-card">
                الإحصائيات داخل النظام هي إحصائيات تراكمية حقيقية منذ آخر جرد،
                ويتم احتسابها بناءً على جميع العمليات المسجلة داخل النظام.
            </div>

            <div class="guide-card">
                الإحصائيات ليست بديلاً عن المحاسب أو المراجعة المحاسبية التفصيلية،
                وإنما أداة قوية لدعم القرار والتحقق من سلامة الوضع المالي بصورة دقيقة.
            </div>

            <div class="guide-card">
                دقة الإحصائيات قد تصل إلى نسب عالية جدًا عند الالتزام بإدخال جميع البيانات
                المالية والمخزنية بصورة صحيحة ومنتظمة.
            </div>

            <div class="guide-card">
                إجمالي السيولة يمثل الرصيد الافتتاحي بالإضافة إلى إجمالي الداخل والخارج المالي،
                بينما صافي السيولة يعبر عن صافي الداخل والخارج دون احتساب رأس المال الافتتاحي.
            </div>

            <div class="guide-card">
                قبل تنفيذ الجرد السنوي أو الدوري يجب تسوية جميع الديون والرواتب والمستحقات المالية،
                لضمان الحصول على نتائج دقيقة ووضع مالي واضح.
            </div>
        </div>

        <!-- المشتريات -->

        <div class="guide-category">
            <h2>🛒 المشتريات</h2>

            <div class="guide-card">
                المشتريات الخارجية تختلف عن المحلية بسبب احتساب تكاليف إضافية
                مثل الشحن والجمارك وتاريخ الوصول.
            </div>

            <div class="guide-card">
                جميع المدخلات المالية داخل المشتريات تعتمد على الدينار الليبي فقط.
            </div>

            <div class="guide-card">
                يتم احتساب صافي الفاتورة بصورة تلقائية لضمان وضوح التكلفة النهائية.
            </div>
        </div>

        <!-- المنتجات والإنتاج -->

        <div class="guide-category">
            <h2>🏭 المنتجات والإنتاج</h2>

            <div class="guide-card">
                سعر البيع داخل المنتج يمثل السعر الافتراضي الذي يتم نقله تلقائيًا للفواتير،
                مع إمكانية تعديله يدويًا عند الحاجة.
            </div>

            <div class="guide-card">
                تكلفة الإنتاج يتم إدخالها مباشرة بواسطة مستخدم النظام،
                وهي تمثل التكلفة الحقيقية لإنتاج الكرتونة أو المنتج.
            </div>

            <div class="guide-card">
                لا يسمح النظام بحذف منتجات تم بيعها فعليًا داخل الفواتير،
                لأن الكميات أصبحت خارجة من المخزون بالفعل.
            </div>

            <div class="guide-card">
                في حال كانت الكمية المتبقية غير كافية لأي عملية بيع،
                يقوم النظام بإظهار تنبيه مباشر لمنع حدوث خلل مخزني.
            </div>
        </div>

        <!-- المخزون -->

        <div class="guide-category">
            <h2>📦 المخزون</h2>

            <div class="guide-card">
                المخزون داخل النظام يعمل بصورة ديناميكية حقيقية،
                ويتأثر بجميع عمليات الشراء والبيع والإنتاج والمرتجعات والتلف.
            </div>

            <div class="guide-card">
                المرتجع الجزئي يعيد الكمية للمخزون بصورة تلقائية ومنظمة.
            </div>

            <div class="guide-card">
                في حال وجود منتجات تالفة يتم إنقاصها يدويًا من صفحة المنتجات
                أو عبر تعديل الكمية حسب حالة التلف.
            </div>

            <div class="guide-card">
                تعديل الأسعار لا يؤثر على الكميات المخزنية نهائيًا.
            </div>
        </div>

        <!-- الفواتير -->

        <div class="guide-category">
            <h2>🧾 الفواتير والمبيعات</h2>

            <div class="guide-card">
                جميع الفواتير تمتلك رقمًا فريدًا لتسهيل البحث والمتابعة والطباعة.
            </div>

            <div class="guide-card">
                يمكن أن تكون الفاتورة خالصة أو جزئية أو دين كامل،
                ويتم الانتقال بين الحالات تلقائيًا حسب الدفعات المسجلة.
            </div>

            <div class="guide-card">
                تفاصيل الفاتورة قابلة للطباعة بصورة احترافية للزبون أو المسوق.
            </div>

            <div class="guide-card">
                صافي الربح داخل الفاتورة يظهر في حقل مخصص ومخفي نسبيًا،
                ويمكن الكشف عنه عبر زر عرض الربح.
            </div>

            <div class="guide-card">
                يتم فصل إجمالي الفاتورة عن عمولة المسوق لضمان وضوح العمليات المالية بصورة دقيقة.
            </div>

            <div class="guide-card">
                يسمح النظام بتعديل سعر البيع يدويًا،
                وعند البيع بسعر أقل من أو يساوي تكلفة الإنتاج يتم تمييز الحقل باللون الأحمر
                للتنبيه إلى وجود خسارة محتملة دون منع العملية.
            </div>
        </div>

        <!-- المرتجعات -->

        <div class="guide-category">
            <h2>🔄 المرتجعات</h2>

            <div class="guide-card">
                الراجع يمثل مرتجعًا جزئيًا،
                بينما الإلغاء يمثل إلغاءً كاملاً للفاتورة.
            </div>

            <div class="guide-card">
                جميع المرتجعات يتم ربطها مباشرة برقم الفاتورة الأصلي،
                مع إمكانية الانتقال السريع بين السجلات.
            </div>

            <div class="guide-card">
                في حال كانت الفاتورة تحتوي على أكثر من طريقة دفع،
                يجب أن يكون مبلغ الاسترجاع متوافقًا مع نوع الدفع المحدد.
            </div>

            <div class="guide-card">
                عند تجاوز مبلغ الإرجاع لنوع الدفع المحدد،
                يجب تنفيذ الاسترجاع المالي أولاً من شاشة الدفعات ثم تنفيذ المرتجع المخزني.
            </div>
        </div>

        <!-- المسوقين -->

        <div class="guide-category">
            <h2>👤 المسوقون والعمولات</h2>

            <div class="guide-card">
                الفرق الأساسي بين الزبون والمسوق أن المسوق يمتلك عمولة مرتبطة بالفواتير.
            </div>

            <div class="guide-card">
                عمولات المسوقين يمكن أن تكون مصروفة أو معلقة حسب حالة المسوق والفاتورة.
            </div>

            <div class="guide-card">
                يمكن لبعض المسوقين الخاصين اعتماد حالة "تصرف الآن" بصورة افتراضية،
                مع إمكانية تعديل الحالة يدويًا عند الحاجة.
            </div>

            <div class="guide-card">
                يسمح النظام بمرونة كاملة في تغيير حالة العمولة
                بما يتناسب مع ظروف العمل والحالات الخاصة.
            </div>
        </div>

        <!-- الخزنات -->

        <div class="guide-category">
            <h2>🏦 الخزنات</h2>

            <div class="guide-card">
                يدعم النظام إنشاء أكثر من خزنة مالية مع إمكانية التحويل بينها بصورة آمنة ومنظمة.
            </div>

            <div class="guide-card">
                يمنع النظام الوصول إلى رصيد سالب داخل أي خزنة.
            </div>

            <div class="guide-card">
                يمكن تعطيل بعض الخزنات عن الاستخدام اليومي دون فقدان بياناتها أو أرصدتها المالية.
            </div>

            <div class="guide-card">
                الرصيد الافتتاحي للخزنات يستخدم عادة بعد الجرد
                لبدء دورة مالية جديدة بصورة صحيحة.
            </div>
        </div>

        <!-- الرواتب والمصاريف -->

        <div class="guide-category">
            <h2>💼 الرواتب والمصاريف</h2>

            <div class="guide-card">
                جميع المصاريف التشغيلية واليومية يجب تسجيلها داخل النظام
                لضمان دقة المتابعة المالية والإحصائيات.
            </div>

            <div class="guide-card">
                يمكن تسجيل السلف المالية للموظفين ومتابعة عمليات السداد بصورة مستقلة.
            </div>

            <div class="guide-card">
                الرواتب والمكافآت يتم احتسابها ضمن سجل الرواتب،
                بينما السلف تعتبر التزامًا ماليًا منفصلاً حتى يتم سدادها.
            </div>
        </div>

        <!-- الأمان -->

        <div class="guide-category">
            <h2>🛡️ الأمان والصلاحيات</h2>

            <div class="guide-card">
                يحتوي النظام على مستويين من المسؤولين وفقًا للصلاحيات المحددة.
            </div>

            <div class="guide-card">
                المسؤول الأول يمتلك صلاحيات الإدارة الكاملة،
                بينما المسؤول الثاني يملك صلاحيات تشغيل محددة دون الوصول للإحصائيات أو إدارة المسؤولين.
            </div>

            <div class="guide-card">
                جميع الأحداث المالية يتم تسجيلها مع نوع العملية والخزنة واسم المسؤول المنفذ.
            </div>

            <div class="guide-card">
                المحافظة على كلمة المرور مسؤولية شخصية،
                ويمنع مشاركة الحسابات بين المستخدمين حفاظًا على سلامة السجلات.
            </div>

            <div class="guide-card">
                مطور النظام مخصص لأعمال الدعم والجرد والصيانة الفنية فقط،
                وليس لمراقبة البيانات اليومية للمصنع.
            </div>
        </div>

        <!-- الأرشفة -->

        <div class="guide-category">
            <h2>🗂️ الأرشفة والنسخ الاحتياطي</h2>

            <div class="guide-card">
                الأرشيف داخل النظام مخصص للقراءة فقط ولا يقبل التعديل نهائيًا.
            </div>

            <div class="guide-card">
                يتم تصدير الأرشيف والتقارير بصيغة PDF غير قابلة للتعديل
                للحفاظ على سلامة البيانات.
            </div>

            <div class="guide-card">
                توضح صفحة الإعدادات حالة التخزين والنسخ الاحتياطي
                للمساعدة في متابعة سلامة البيانات.
            </div>

            <div class="guide-card">
                المدة المستحسنة للعمل قبل الجرد الكامل هي سنة تشغيلية كاملة
                يتبعها جرد سنوي شامل.
            </div>
        </div>

        <!-- الخاتمة -->

        <div class="guide-category">
            <h2>✨ رسالة النظام</h2>

            <div class="guide-card">
                تسر شركة الحداثة للأنظمة الرقمية إطلاق نظام السلطان لإدارة المصنع،
                ونسأل الله لكم التوفيق والنجاح في أعمالكم.
            </div>

            <div class="guide-card">
                لأي استفسار أو دعم فني يرجى التواصل مع إدارة الفريق أو الدعم الفني المعتمد.
            </div>
        </div>

    </div>

</div>