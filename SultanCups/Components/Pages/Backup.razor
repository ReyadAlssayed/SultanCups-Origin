@page "/Backup"
@using SultanCups.Services
@inject AdminService AdminService
@layout Layout.MainLayout
@inject NavigationManager Nav

<div class="bk-page">

    <div class="bk-top-bar">

        <button class="bk-btn-back"
                @onclick="GoBack">

            <span class="back-icon">➡️</span>

            الرجوع للإعدادات

        </button>

    </div>

    @if (isLoading)
    {
        <div class="bk-loader">

            <p>
                جاري فحص حالة التخزين الحقيقية...
            </p>

        </div>
    }
    else
    {
        <div class="storage-monitor-section">

            <div class="storage-card">

                <div class="storage-header">

                    <div class="storage-title">

                        <span class="storage-icon">💾</span>

                        <div>

                            <h4>
                                حالة تخزين قاعدة البيانات
                            </h4>

                            <p>
                                PostgreSQL الحقيقية (Local)
                            </p>

                        </div>

                    </div>

                    <div class="storage-percentage-badge">

                        @StoragePercent.ToString("0.00")%

                    </div>

                </div>

                <div class="storage-progress-container">

                    <div class="storage-progress-bar"
                         style="width:@(Math.Max(2, StoragePercent))%">

                        @if (StoragePercent > 5)
                        {
                            <span class="inner-pct">
                                @StoragePercent.ToString("0.0")%
                            </span>
                        }

                    </div>

                </div>

                <div class="storage-footer">

                    <span class="status-msg">

                        <i class="state-dot"></i>

                        @if (UsedStorageMB < 100)
                        {
                            <span style="color:#059669;">
                                حالة ممتازة: استهلاك البيانات منخفض جدًا.
                            </span>
                        }
                        else if (UsedStorageMB < 500)
                        {
                            <span style="color:#2563eb;">
                                حالة جيدة: نمو البيانات طبيعي.
                            </span>
                        }
                        else
                        {
                            <span style="color:#dc2626;">
                                تنبيه: حجم البيانات بدأ يزداد.
                            </span>
                        }

                    </span>

                    <div class="storage-info-text">

                        <span>
                            حجم القاعدة:
                            <strong>
                                @UsedStorageMB MB
                            </strong>
                        </span>

                        <span class="separator">|</span>

                        <span>
                            المساحة الفارغة:
                            <strong>
                                @FreeDiskGb GB
                            </strong>
                        </span>

                    </div>

                </div>

            </div>

        </div>
    }

</div>

@code {

    double UsedStorageMB;

    double FreeDiskGb;

    double StoragePercent;

    bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var result =
            await AdminService.GetStorageStatus();

        UsedStorageMB = result.usedMb;

        FreeDiskGb = result.freeGb;

        double totalDiskMb =
            (FreeDiskGb * 1024)
            + UsedStorageMB;

        StoragePercent =
            (UsedStorageMB / totalDiskMb) * 100;

        isLoading = false;
    }

    void GoBack()
    {
        Nav.NavigateTo("/Settings");
    }
}