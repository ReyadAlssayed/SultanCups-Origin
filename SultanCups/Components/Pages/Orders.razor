        <td>@(o.person_type == "customer" ? "زبون" : "مسوق")</td>

        <td>@o.person_name</td>

        <td>@o.items_count</td>

                                <td>
                                    @(o.paid_amount == 0
    ? "غير خالص"
    : o.paid_amount < o.net_total
        ? "جزئي"
        : "خالص")
                                    
        </td>

                                            <td class="profit-col">
