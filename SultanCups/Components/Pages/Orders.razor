                                            </span>
                                        }
                                        </span>
                                    </td>
                                


                               

     <td>

    <div class="order-actions">



        @if (!o.is_cancelled)
        {

                   <button class="btn-info"
        @onclick="() => OpenDetails(o)">
    تفاصيل
</button>

<button class="btn-edit"
        @onclick='() => Nav.NavigateTo($"/orders/edit/{o.order_id}")'>
