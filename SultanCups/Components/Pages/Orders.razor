                    }
                    else
                    {
                        @foreach (var o in FilteredOrders)
{
    bool isOld =
    o.order_date < lastArchiveDate
    &&
    o.paid_amount < o.net_total;

    <tr id="order-@o.order_id"
    class="@(
    o.is_cancelled
        ? "cancelled-row"
        : isOld
            ? "old-archive-row"
            : o.order_id == HighlightId
                ? "new-row"
                : ""
)">

