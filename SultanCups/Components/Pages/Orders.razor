@page "/orders"
@layout Layout.MainLayout

@using SultanCups.Models
@using SultanCups.Services

@inject SultanCups.Services.UserSession Session
@inject FinanceService2 FinanceService
@inject InventoryService InventoryService
@inject SalesService SalesService
@inject ToastService ToastService
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Components

<div class="pro-page">

    <div class="pro-topbar">
        <button class="pro-btn-add" @onclick='() => Nav.NavigateTo("/orders/add")'>
            إضافة فاتورة
        </button>
        <h2 class="pro-title">فواتير المبيعات</h2>
        <div></div>
    </div>


   <div class="pro-search-bar">

    <input class="mk-search-input"
           placeholder="ابحث برقم الفاتورة أو الاسم"
           @bind="SearchText"
           @bind:event="oninput" />

    <select class="pro-filter-select" @bind="StatusFilter">
        <option value="all">كل الحالات</option>
        <option value="paid">خالص</option>
        <option value="partial">جزئي</option>
        <option value="unpaid">غير خالص</option>
    </select>

    <input type="date"
           class="pro-filter-select"
           @bind="DateFilter" />

</div>


    <div class="pro-card">
        <div class="pro-table-wrap">
            <table class="pro-table">
                <thead>
                    <tr>
                        <th>رقم</th>
                        <th>النوع</th>
                        <th>الاسم</th>
                        <th>عدد الأصناف</th>
                        <th>الحالة</th>
                        <th>التاريخ</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (OrdersList == null)
                    {
                        <tr>
                            <td colspan="10" class="st-empty-text">
                                <span>جاري التحميل...</span>
                            </td>
                        </tr>
                    }
                    else if (!FilteredOrders.Any())
                    {
                        <tr>
                            <td colspan="10" class="st-empty-text">
                                <div class="empty-state">
                                    <img src="images/Empty.jpg" class="empty-img" />
                                    <span>لا توجد فواتير</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var o in FilteredOrders)
{
    <tr id="order-@o.order_id"
    class="@(o.is_cancelled
        ? "cancelled-row"
        : o.order_id == HighlightId
            ? "new-row"
            : "")">

        <td>@o.order_id</td>

        <td>@(o.person_type == "customer" ? "زبون" : "مسوق")</td>

        <td>@o.person_name</td>

        <td>@o.items_count</td>

                                <td>
                                    @(o.paid_amount == 0
    ? "غير خالص"
    : o.paid_amount < o.net_total
        ? "جزئي"
        : "خالص")
                                    
        </td>

                                <td>
                                    @o.order_date.ToString("yyyy-MM-dd")
                                </td>

     <td>

    <button class="btn-info"
            @onclick="() => OpenDetails(o)">
        تفاصيل
    </button>

    @if (!o.is_cancelled)
    {
        <button class="btn-edit"
                @onclick='() => Nav.NavigateTo($"/orders/edit/{o.order_id}")'>
            تعديل
        </button>

        <button class="btn-delete"
                @onclick="() => OpenDisableDialog(o)">
            إلغاء
        </button>

        <button class="btn-return">
            ترجيع
        </button>
    }
    else
    {
        <span class="cancelled-text">
            ملغاة
        </span>
    }

</td>

    </tr>
}
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (ShowDetails && SelectedOrder != null)
{
    <div class="sal-dialog-overlay">

        <div class="sal-dialog-box">

            <div class="sal-dialog-top"></div>

            <div class="sal-dialog-body">

                <h3>تفاصيل الفاتورة</h3>

                <div class="details-list">

                    <div class="row">
                        <span>رقم الفاتورة</span>
                        <span>INV-@SelectedOrder.order_id.ToString("D4")</span>
                    </div>

                    <div class="row">
                        <span>الاسم</span>
                        <span>@SelectedOrder.person_name</span>
                    </div>

                    <div class="row">
    <span>عدد الأصناف</span>
    <span>@SelectedOrder.items_count</span>
</div>

<div class="row">
    <span>إجمالي الكمية</span>
    <span>@SelectedOrder.total_quantity صندوق</span>
</div>

                    <div class="row">
                        <span>الإجمالي</span>
                        <span>@Fmt(SelectedOrder.total)</span>
                    </div>

                    <div class="row">
                        <span>الخصم</span>
                        <span>@Fmt(SelectedOrder.discount_total)</span>
                    </div>

                    <div class="row">
                        <span>الإجمالي بعد الخصم</span>
                        <span>@Fmt(SelectedOrder.net_total)</span>
                    </div>

                    <div class="row">
    <span>المدفوع</span>
    <span class="paid-green">
        @Fmt(SelectedOrder.paid_amount)
    </span>
</div>

<div class="row">
    <span>المتبقي</span>
    <span class="remain-red">
        @Fmt(SelectedOrder.net_total - SelectedOrder.paid_amount)
    </span>
</div>

<div class="row">
   <span class="status-text">الحالة</span>
   <span class="@GetStatusClass(SelectedOrder)">
    @(SelectedOrder.paid_amount == 0
        ? "غير خالص"
        : SelectedOrder.paid_amount < SelectedOrder.net_total
            ? "جزئي"
            : "خالص")
</span>
</div>

                   @if (SelectedOrder.person_type == "marketer")
{
    <div class="row">
        <span>العمولة</span>
        <span>@Fmt(SelectedOrder.commission_total)</span>
    </div>

    bool canPayCommission =
        SelectedOrder.is_special ||
        SelectedOrder.paid_amount >= SelectedOrder.net_total;

    <div class="row">
        <span>حالة العمولة</span>
        <span class="@(canPayCommission ? "status-green" : "status-red")">
            @(canPayCommission ? "تُصرف" : "معلقة")
        </span>
    </div>
}

                  @if (PaymentMethods.Any())
{
    <div class="row">
        <span>طريقة الدفع</span>
        <span>
            @(PaymentMethods.Count == 1
                ? PaymentMethods.First()
                : string.Join(" | ", PaymentMethods))
        </span>
    </div>
}
                    <div class="row">
                        <span>التاريخ</span>
                       <span class="dt-box">
    <span class="dt-day">
        @SelectedOrder.order_date.ToLocalTime().ToString("yyyy-MM-dd")
    </span>

</span>
                    </div>

                </div>

                @if (!SelectedOrder.is_cancelled)
{
    <button class="btn-pdf-save" onclick="printOrderCard()">
        🖨️ طباعة الفاتورة
    </button>
}
                
                <button class="btn-cancel" @onclick="CloseDetails">
                    إغلاق
                </button>

            </div>
<div class="print-only">

@if (SelectedItems.Any())
{
    <table style="margin-top:20px;">
        <thead>
            <tr>
                <th>المنتج</th>
                <th>الكمية</th>
                <th>السعر</th>
                <th>الإجمالي</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in SelectedItems)
            {
                <tr>
                    <td>@item.product_name</td>
                    <td>@item.quantity</td>
                    <td>@Fmt(item.unit_price)</td>
                    <td>@Fmt(item.total)</td>
                </tr>
            }
        </tbody>
    </table>
}

</div>

        </div>

    </div>
}

@if (ShowDisableDialog && DisableOrder != null)
{
    <div class="pro-dialog-overlay">

        <div class="pro-dialog-box small-dialog">

            <div class="pro-dialog-top-image">
                <img src="images/Background.png" />
            </div>

            <div class="pro-dialog-body">

                <h3>إلغاء الفاتورة</h3>

                <p>
                    سيتم إرجاع المنتجات التالية إلى المخزن:
                </p>

                <div class="disable-items">

                    @foreach (var item in DisableItems)
                    {
                        <div class="disable-row">
                            - @item.product_name
                            (الكمية: @item.quantity)
                        </div>
                    }

                </div>

                @if (DisableOrder.paid_amount > 0)
                {
                    <div class="refund-note">

                        سيتم إخراج مبلغ
                        @Fmt(DisableOrder.paid_amount)

                        وإرجاعه إلى

                        @(DisableOrder.person_type == "customer"
                            ? "الزبون"
                            : "المسوق")

                    </div>
                }

                <div class="pro-dialog-actions">

                   <button class="pro-save"
        @onclick="ConfirmCancelOrder">
    تأكيد الإلغاء
</button>

                    <button class="pro-cancel"
                            @onclick="() => ShowDisableDialog = false">
                        إلغاء
                    </button>

                </div>

            </div>

        </div>

    </div>
}

@code {

    List<OrderView>? OrdersList;

    [Parameter]
    [SupplyParameterFromQuery(Name = "new")]
    public string? newId { get; set; }

    int HighlightId => int.TryParse(newId, out var id) ? id : 0;

    int CurrentAdminId => Session.AdminId;
    string Fmt(decimal v) => $"{v:0.00} د.ل";

    OrderView? SelectedOrder;
    bool ShowDetails = false;

    List<OrderItem> SelectedItems = new();
    List<string> PaymentMethods = new();

    string SearchText = "";

string StatusFilter = "all";

bool ShowDisableDialog = false;

OrderView? DisableOrder;

List<OrderItem> DisableItems = new();

DateTime? DateFilter;
   
    protected override async Task OnInitializedAsync()
    {
        OrdersList = await FinanceService.GetOrders();
    }

protected override void OnParametersSet()
{
    if (!string.IsNullOrEmpty(newId))
    {
        _ = ScrollToOrder();
        _ = ClearHighlight();
    }
}

    string GetPaymentName(string method)
{
    return method switch
    {
        "cash" => "نقدي",
        "transfer" => "تحويل",
        "card" => "بطاقة",
        "check" => "شيك",
        _ => method
    };
}

[Inject] IJSRuntime JS { get; set; } = default!;

async Task PrintInvoice()
{
    await JS.InvokeVoidAsync("printOrderCard");
}
    async Task ClearHighlight()
    {
        await Task.Delay(5000); // 5 ثواني
        if (Nav.Uri.Contains("/orders"))
{
    Nav.NavigateTo("/orders");
}
    }


    async Task ScrollToOrder()
{
    await Task.Delay(300);

    await JS.InvokeVoidAsync(
        "eval",
        $"document.getElementById('order-{HighlightId}')?.scrollIntoView({{behavior:'smooth', block:'center'}})"
    );
}

IEnumerable<OrderView> FilteredOrders =>
    (OrdersList ?? new List<OrderView>())
    .Where(o =>

        // البحث
        (
            string.IsNullOrWhiteSpace(SearchText)
            ||
            o.order_id.ToString().Contains(SearchText)
            ||
            (o.person_name != null &&
             o.person_name.Contains(SearchText, StringComparison.OrdinalIgnoreCase))
        )

        // فلترة التاريخ
        &&

        (
            DateFilter == null
            ||
            o.order_date.Date == DateFilter.Value.Date
        )

        // فلترة الحالة
        &&

        (
            StatusFilter == "all"

            ||

            (
                StatusFilter == "paid"
                &&
                o.paid_amount >= o.net_total
            )

            ||

            (
                StatusFilter == "partial"
                &&
                o.paid_amount > 0
                &&
                o.paid_amount < o.net_total
            )

            ||

            (
                StatusFilter == "unpaid"
                &&
                o.paid_amount == 0
            )
        )
    );
   
async Task OpenDetails(OrderView o)
{
    var order = await FinanceService.GetOrderById(o.order_id);

    if (order == null) return;

    SelectedOrder = o;
   var products = await FinanceService.GetProductsDict();

SelectedItems = order.Items;

foreach (var item in SelectedItems)
{
    if (products.ContainsKey(item.product_id))
    {
        item.product_name = products[item.product_id];
    }
}

    // 🔥 جلب طرق الدفع
    var payments = await FinanceService.GetPaymentsByOrder(o.order_id);
    PaymentMethods = payments
    .Where(p => !string.IsNullOrWhiteSpace(p.payment_method))
    .Select(p => GetPaymentName(p.payment_method!))
    .Where(x => x != "-" && !string.IsNullOrWhiteSpace(x))
    .Distinct()
    .ToList();

    ShowDetails = true;
}

string GetStatusClass(OrderView o)
{
    if (o.paid_amount == 0) return "status-red";
    if (o.paid_amount < o.net_total) return "status-orange";
    return "status-green";
}

async Task OpenDisableDialog(OrderView o)
{
    DisableOrder = o;

    var order = await FinanceService.GetOrderById(o.order_id);

    if (order == null)
        return;

    var products = await FinanceService.GetProductsDict();

    DisableItems = order.Items;

    foreach (var item in DisableItems)
    {
        if (products.ContainsKey(item.product_id))
        {
            item.product_name = products[item.product_id];
        }
    }

    ShowDisableDialog = true;
}

async Task ConfirmCancelOrder()
{
    if (DisableOrder == null)
        return;

    var result = await FinanceService.CancelOrder(
        DisableOrder.order_id,
        CurrentAdminId);

    if (result.success)
    {
        ToastService.ShowToast(result.message, "success");

        OrdersList = await FinanceService.GetOrders();

        ShowDisableDialog = false;
    }
    else
    {
        ToastService.ShowToast(result.message, "error");
    }
}


void CloseDetails()
{
    ShowDetails = false;
    SelectedOrder = null;
    PaymentMethods.Clear(); // 🔥 مهم
}
}