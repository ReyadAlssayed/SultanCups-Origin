@code {

    List<OrderView>? OrdersList;

    [Parameter]
    [SupplyParameterFromQuery(Name = "new")]
    public string? newId { get; set; }

    int HighlightId => int.TryParse(newId, out var id) ? id : 0;

    int CurrentAdminId => Session.AdminId;
    string Fmt(decimal v) => $"{v:0.00} د.ل";

    OrderView? SelectedOrder;
    bool ShowDetails = false;

    List<OrderItem> SelectedItems = new();
    List<string> PaymentMethods = new();

    bool ShowReturnPreview = false;

    DateTime lastArchiveDate;

    bool ShowReturnErrorDialog = false;

string ReturnErrorMessage = "";

decimal ReturnRefundAmount = 0;

decimal ReturnCommissionAmount = 0;
string SelectedRefundMethod = "";

    string SearchText = "";

string StatusFilter = "all";

bool ShowDisableDialog = false;

int SelectedMonth = 0;
int SelectedYear = 0;
bool IsExporting = false;

OrderView? DisableOrder;

List<OrderItem> DisableItems = new();

bool ShowReturnDialog = false;

OrderView? ReturnOrder;

List<ReturnItemInput> ReturnItems = new();

DateTime? DateFilter;
bool ShowProfit = false;
   
    protected override async Task OnInitializedAsync()
    {
        OrdersList = await FinanceService.GetOrders();
        lastArchiveDate =
    await StatsService.GetLastArchiveDate();
    }

protected override void OnParametersSet()
{
    if (!string.IsNullOrEmpty(newId))
    {
        _ = ScrollToOrder();
        _ = ClearHighlight();
    }
}

    string GetPaymentName(string method)
{
    return method switch
    {
        "cash" => "نقدي",
        "transfer" => "تحويل",
        "card" => "بطاقة",
        "check" => "شيك",
        _ => method
    };
}


async Task PrintInvoice()
{
    await JS.InvokeVoidAsync("printOrderCard");
}
   async Task ClearHighlight()
{
    await Task.Delay(5000);

    if (Nav.Uri.EndsWith("/orders"))
    {
        Nav.NavigateTo("/orders");
    }
}




    async Task ScrollToOrder()
{
    await Task.Delay(300);

    await JS.InvokeVoidAsync(
        "eval",
        $"document.getElementById('order-{HighlightId}')?.scrollIntoView({{behavior:'smooth', block:'center'}})"
    );
}

IEnumerable<OrderView> FilteredOrders =>
    (OrdersList ?? new List<OrderView>())
    .Where(o =>

        // البحث
        (
            string.IsNullOrWhiteSpace(SearchText)
            ||
            o.order_id.ToString().Contains(SearchText)
            ||
            (o.person_name != null &&
             o.person_name.Contains(SearchText, StringComparison.OrdinalIgnoreCase))
        )

        // فلترة التاريخ
        &&

        (
            DateFilter == null
            ||
            o.order_date.Date == DateFilter.Value.Date
        )

        // فلترة الحالة
        &&

        (
            StatusFilter == "all"

            ||

            (
                StatusFilter == "paid"
                &&
                o.paid_amount >= o.net_total
            )

            ||

            (
                StatusFilter == "partial"
                &&
                o.paid_amount > 0
                &&
                o.paid_amount < o.net_total
            )

            ||

            (
                StatusFilter == "unpaid"
                &&
                o.paid_amount == 0
            )
        )

        // فلترة الشهر
        &&

        (
            SelectedMonth == 0
            ||
            o.order_date.Month == SelectedMonth
        )

        // فلترة السنة
        &&

        (
            SelectedYear == 0
            ||
            o.order_date.Year == SelectedYear
        )
    );
   
async Task OpenDetails(OrderView o)
{
    var order = await FinanceService.GetOrderById(o.order_id);

    if (order == null) return;

    SelectedOrder = o;
   var products = await FinanceService.GetProductsDict();

SelectedItems = order.Items;

foreach (var item in SelectedItems)
{
    if (products.ContainsKey(item.product_id))
    {
        item.product_name = products[item.product_id];
    }
}

    // 🔥 جلب طرق الدفع
    var payments = await FinanceService.GetPaymentsByOrder(o.order_id);
    PaymentMethods = payments
    .Where(p => !string.IsNullOrWhiteSpace(p.payment_method))
    .Select(p => GetPaymentName(p.payment_method!))
    .Where(x => x != "-" && !string.IsNullOrWhiteSpace(x))
    .Distinct()
    .ToList();

    ShowDetails = true;
}

string GetStatusClass(OrderView o)
{
    if (o.paid_amount == 0) return "status-red";
    if (o.paid_amount < o.net_total) return "status-orange";
    return "status-green";
}

async Task OpenDisableDialog(OrderView o)
{
    DisableOrder = o;

    var order = await FinanceService.GetOrderById(o.order_id);

    if (order == null)
        return;

    var products = await FinanceService.GetProductsDict();

    DisableItems = order.Items;

    foreach (var item in DisableItems)
    {
        if (products.ContainsKey(item.product_id))
        {
            item.product_name = products[item.product_id];
        }
    }

    ShowDisableDialog = true;
}

async Task ExportToExcel()
{
    if (IsExporting)
        return;

    IsExporting = true;

    await InvokeAsync(StateHasChanged);

    try
    {
        using var workbook = new XLWorkbook();

        var ws =
            workbook.Worksheets.Add("الفواتير");

        ws.Cell(1, 1).Value = "رقم";
        ws.Cell(1, 2).Value = "النوع";
        ws.Cell(1, 3).Value = "الاسم";
        ws.Cell(1, 4).Value = "عدد الأصناف";
        ws.Cell(1, 5).Value = "الحالة";
        ws.Cell(1, 6).Value = "صافي الربح";
        ws.Cell(1, 7).Value = "التاريخ";

        int row = 2;

        foreach (var o in FilteredOrders)
        {
            ws.Cell(row, 1).Value = o.order_id;

            ws.Cell(row, 2).Value =
                o.person_type == "customer"
                    ? "زبون"
                    : "مسوق";

            ws.Cell(row, 3).Value = o.person_name;

            ws.Cell(row, 4).Value = o.items_count;

            ws.Cell(row, 5).Value =
                o.paid_amount == 0
                    ? "غير خالص"
                    : o.paid_amount < o.net_total
                        ? "جزئي"
                        : "خالص";

            ws.Cell(row, 6).Value = o.profit;

            ws.Cell(row, 7).Value =
                o.order_date.ToString("yyyy-MM-dd");

            bool isOld =
                o.order_date < lastArchiveDate
                &&
                o.paid_amount < o.net_total;

            if (isOld)
            {
                ws.Range(row, 1, row, 7)
                    .Style.Fill.BackgroundColor =
                        XLColor.FromHtml("#fff7ed");
            }

            row++;
        }

        ws.Row(1).Style.Font.Bold = true;

        ws.Row(1).Style.Fill.BackgroundColor =
            XLColor.LightGreen;

        ws.Columns().AdjustToContents();

        ws.RightToLeft = true;

        using var stream = new MemoryStream();

        workbook.SaveAs(stream);

        await JS.InvokeVoidAsync(
            "downloadFile",
            $"Orders_{DateTime.Now:yyyyMMddHHmmss}.xlsx",
            Convert.ToBase64String(stream.ToArray())
        );
    }
    finally
    {
        IsExporting = false;

        await InvokeAsync(StateHasChanged);
    }
}

async Task OpenReturnDialog(OrderView o)
{
    ReturnOrder = o;

    ReturnItems =
        await FinanceService
            .GetOrderItemsForReturn(o.order_id);

    // 🔥 تصفير تلقائي
    SelectedRefundMethod = "";

    ReturnRefundAmount = 0;

    ReturnCommissionAmount = 0;

    // 🔥 جلب طرق الدفع
    var payments =
        await FinanceService
            .GetPaymentsByOrder(o.order_id);

    PaymentMethods = payments
        .Where(p =>
            !string.IsNullOrWhiteSpace(p.payment_method))
        .Select(p =>
            GetPaymentName(p.payment_method!))
        .Where(x =>
            x != "-" &&
            !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .ToList();


    ShowReturnDialog = true;
}

async Task ConfirmCancelOrder()
{
    if (DisableOrder == null)
        return;

    var result = await FinanceService.CancelOrder(
        DisableOrder.order_id,
        CurrentAdminId);

    if (result.success)
    {
        ToastService.ShowToast(result.message, "success");

        OrdersList = await FinanceService.GetOrders();

        ShowDisableDialog = false;
    }
    else
    {
ToastService.ShowToast(
    "تعذر إكمال العملية بسبب خطأ داخلي، يرجى التواصل مع مطور النظام",
    "error"
);  
    }
}

async Task ConfirmPartialReturn()
{
    if (ReturnOrder == null)
        return;

    var validItems =
        ReturnItems
        .Where(x => x.return_quantity > 0)
        .ToList();

    if (!validItems.Any())
    {
        ToastService.ShowToast(
            "أدخل كمية راجعة",
            "error");

        return;
    }

    var returnTotal =
    validItems.Sum(x =>
        x.return_quantity * x.unit_price);

var currentNet =
    ReturnOrder.net_total;

var currentPaid =
    ReturnOrder.paid_amount;

var newNet =
    currentNet - returnTotal;

ReturnRefundAmount =
    Math.Max(currentPaid - newNet, 0);

    ReturnCommissionAmount =
        ReturnOrder.person_type == "marketer"
        &&
        ReturnOrder.pay_commission_now
            ? validItems.Sum(x =>
                x.return_quantity *
                x.commission_per_box)
            : 0;

    ShowReturnPreview = true;
}

async Task ExecutePartialReturn()
{

if (
    PaymentMethods.Count > 1
    &&
    ReturnRefundAmount > 0
    &&
    string.IsNullOrWhiteSpace(SelectedRefundMethod)
)
{
    ToastService.ShowToast(
        "اختر طريقة استرجاع المبلغ",
        "error"
    );

    return;
}
    if (ReturnOrder == null)
        return;

    var result =
       await FinanceService.ProcessPartialReturn(
    ReturnOrder.order_id,
    ReturnItems,
    CurrentAdminId,
    SelectedRefundMethod);

   if (result.success)
{
    ToastService.ShowToast(
        result.message,
        "success");

    OrdersList =
        await FinanceService.GetOrders();

    ShowReturnDialog = false;

    ShowReturnPreview = false;

    ReturnItems.Clear();

    ReturnRefundAmount = 0;

    ReturnCommissionAmount = 0;

    SelectedRefundMethod = "";
}
    else
{
    ReturnErrorMessage =
    "تعذر إكمال العملية بسبب خطأ داخلي، يرجى التواصل مع مطور النظام";

    ShowReturnErrorDialog = true;
}
}

void CloseReturnDialog()
{
    ShowReturnDialog = false;

    SelectedRefundMethod = "";

    ReturnRefundAmount = 0;

    ReturnCommissionAmount = 0;

    ReturnItems.Clear();
}


void CloseDetails()
{
    ShowDetails = false;
    SelectedOrder = null;
    PaymentMethods.Clear(); // 🔥 مهم
}
